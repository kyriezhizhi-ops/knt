اگر کنٹرول کیا جائے تو اس کے لیے مزید انتہائی اقدامات کی ضرورت ہوتی ہے، جس میں بنیادی تجدیدی تعداد کو 1 سے کم کرکے وبا کی صورتحال کو بدلنا ہوتا ہے۔ بیماری کے پھیلاؤ کو کنٹرول کرنے کا ایک حصہ یہ ہے کہ ہم وبا کے اونچے سرے کو کم کرنے کی کوشش کریں، جسے ہمیں وبا کے منحنی کو چپکا کر کہتے ہیں۔
اس سے صحت کی دیکھ بھال کے نظام کے تباہ ہونے کا خطرہ کم ہو جائے گا اور ویکسین اور علاج کے طریقوں کے تیار کرنے میں مزید وقت ملے گا۔
غیر دوائی مداخلات جو وائرس کے پھیلاؤ کو کنٹرول کرنے میں مدد کریں، افراد کی حفاظت کے اقدامات جیسے ہاتھوں کی صفائی، ماسک پہننا اور خود کو علیحدہ کرنا؛ معاشرے کے اقدامات جیسے اسکولوں کو بند کرنا اور بڑے جماعتوں کے اجتماعات کو منسوخ کرنا، جو فزیکل دستیابی برقرار رکھنے کے لیے ہیں؛ معاشرے کے اقدامات جو اس قسم کے مداخلات کو قبول کرنے اور ان میں شرکت کو encourage کرنے کے لیے ہیں؛ اور سطح کی صفائی جیسے ماحولیاتی اقدامات۔ واضح طور پر بڑھتے ہوئے وائرس کے پھیلاؤ کے مقابلے میں چین نے فوری طور پر مزید سخت وائرس کنٹرول اقدامات، جیسے شہروں کو بند کرنا اور سخت سفری پابندیاں عائد کرنا، شروع کر دیے۔
دیگر ممالک اور علاقوں نے وائرس کے پھیلاؤ کو محدود کرنے کے لیے مختلف اقدامات کیے ہیں۔
کوریا نے وسیع پیمانے پر فلٹریشن اور مقامی اسٹیشننگ کے اقدامات کو اپنایا ہے اور متاثرہ افراد کے سفر کے راستوں کے بارے میں انتباہ جاری کیا ہے۔
سنگاپور نے خود کو علیحدہ کرنے والے مریضوں کو مالی مدد فراہم کی ہے اور علیحدگی اختیار نہ کرنے والے مریضوں پر بڑی جرمانہ عائد کیا ہے۔
چینی تائیوان نے ماسکوں کی پیداوار بڑھائی اور میڈیکل سپلائیز کے فروخت کرنے والے کمپنیوں کو مہنگائی کے خلاف سخت سزا دی۔ برطانیہ اور امریکہ کے ماڈلز سے پتہ چلا ہے کہ وائرس کے پھیلاؤ کو کم کرنے (تیزی سے پھیلاؤ کو کم کرنا لیکن روکنا نہیں) اور روکنے (پھیلاؤ کے رجحان کو بدلنا) دونوں میں بڑی مشکلات کا سامنا ہے۔
بہترین مداخلہ کی پالیسیاں ہسپتالوں کی اعلیٰ مانگ کو 2/3 تک کم کر سکتی ہیں اور اموات کو آدھا کر سکتی ہیں، لیکن اب بھی لاکھوں افراد کی موت کا سبب بن سکتی ہیں اور صحت کے نظام کو تباہ کر سکتی ہیں۔
ممکنہ طور پر احتیاطی اقدامات پہلی ترجیح ہوں گے، لیکن وائرس کے لوگوں میں پھیلنے کے بند ہونے تک (یا ویکسین کے متعارف ہونے تک، جو پہلے آئے) برقرار رکھے جائیں گے، ورنہ اگر اقدامات کو نرم کیا گیا تو پھیلاؤ فوری طور پر بڑھ جائے گا۔
طویل عرصے تک وائرس کے پھیلاؤ کو روکنے کے اقدامات میں معاشرتی اور معاشی خرچہ آتا ہے۔
اپنے اب تک کوئی خاص وائرس کش دوا کو کوویڈ -19 کے لیے منظوری نہیں دی گئی ہے، لیکن تحقیق جاری ہے، جس میں موجودہ ادویات کے ٹیسٹ بھی شامل ہیں۔
غیر منشی ہنگامہ دوا، مائع کی تکمیل اور آرام کرنا علامات کو کم کرنے میں مددگار ہو سکتا ہے۔
حالت کی شدت کے مطابق، آکسیجن تھراپی، وینوں کے ذریعے مائعات کا داخلہ اور سانس کی حمایت کی ضرورت ہو سکتی ہے۔
سٹیروئڈز کے استعمال سے حالت خراب ہو سکتی ہے۔
موجودہ دور میں کچھ ایسے کیمیائی اجزاء کی تحقیق کی جا رہی ہے جو پہلے دیگر وائرل بیماریوں کے علاج کے لیے منظور کیے گئے تھے، تاکہ ان کی COVID-19 کے علاج کے لیے مناسب ہونے کا پتہ لگایا جا سکے۔
وی ایچ او نے یہ بھی نوٹ کیا کہ کچھ "روایتی اور گھریلو علاج" ایس ایس اے آر ایس کوویڈ-19 کے علامات کو کم کرنے میں مددگار ہو سکتے ہیں۔
عالمی صحت تنظیم نے کہا ہے کہ کوویڈ-19 کے مریضوں کی ضروریات کو پورا کرنے کے لیے صحت کے نظام کو بہتر بنانا اور اسے مناسب بنانا بنیادی وائرس کے مقابلے میں اقدامات ہیں۔
ایی سی ڈی سی اور ورلڈ ہیلتھ آرگنائزیشن کے یورپی علاقائی دفتر نے ہسپتالوں اور پرائمری ہیلتھ کیئر سروسز کے لیے ہدایات جاری کی ہیں جن میں متعدد سطحوں پر وسائل منتقل کرنے کے طریقے شامل ہیں، جیسے کہ کوویڈ-19 ٹیسٹنگ کے لیے لیبارٹری سروسز کو مرکزی بنانا، انتخابی پروگرامز کو ممکنہ حد تک منسوخ کرنا، کوویڈ-19 مثبت مریضوں کو الگ کرنا اور انہیں علیحدہ کرنا، اور عملے کو تربیت دینے اور دستیاب وینٹیلیٹرز اور بیڈز کی تعداد بڑھا کر آئی سی یو کی صلاحیت بڑھانا۔
پہلے کیس (یعنی صرف صفر کے مریض) کی اصل جگہ کے بارے میں مختلف قسم کے خیالات ہیں۔
پہلی جانچ کی گئی کورونا وائرس کی بیماری کی صورت 2019 کے دسمبر کے پہلے دن چین کے ہوبی کے ووہان میں ہو سکتی ہے۔
ایک ماہ کے اندر، ہوبی صوبے میں کورونا وائرس کے کیسز تیزی سے بڑھے۔
یہ مریض اکثر جنوبی چین کے ہوا نہیں کے مارکیٹ سے وابستہ تھے، جہاں زندہ جانوروں کی فروخت بھی ہوتی تھی، ایک نظریہ کے مطابق کورونا وائرس کا ذریعہ کسی ایک جانور سے ہے، یا دوسرے الفاظ میں، ایک زونوسس سے ہے۔ 26 دسمبر کو، ہوبی صوبے کے ہسپتال میں ڈاکٹر چانگ جی سین نے پہلی بار ایک گروہ کو نامعلوم وجوہات کی وجہ سے سانس کی بیماری کے مریضوں کو دیکھا اور 27 دسمبر کو اس کی اطلاع ووہان کے جنگ ہان علاقے کے بیماریوں کے روک تھام اور نگرانی کے مرکز کو دی۔
30 دسمبر کو ووہان سینٹرل ہسپتال کے ایک گروپ نے اپنے ساتھیوں کو ایک "SARS جیسے کورونا وائرس" کے خطرے سے آگاہ کیا۔
لی ون لیانگ سمیت آٹھ ڈاکٹروں کو "غلط خبروں" کے پھیلائے جانے کے الزام میں پولیس نے ڈانٹا، جبکہ ایک اور ڈاکٹر ای فن کو اطلاع دینے پر اپنے سربراہ نے ڈانٹا۔
وہاں کے صحت کے محکمہ نے 31 دسمبر کو ایک اعلان جاری کیا اور عالمی صحت کے ادارے کو اطلاع دی۔
1 کی ابتداء میں، ووہان کے صحت کے اداروں نے بہت سے غیر متعین علامات والے سانس کے مسائل کے کیسز کی رپورٹس کے بعد ایک تحقیق شروع کی۔ وائرس کے پھیلاؤ کے ابتدائی دور میں، کیسز کی تعداد تقریباً ہر سات دن آدھے میں دوگنا ہو جاتی تھی۔
جنوری 2020 کے آغاز سے میانہ تک، چین کے سالانہ نئے سال کے تہوار کے دوران ہونے والی آبادی کی بڑی تبدیلی اور ووہان کے ٹرانسپورٹ اور اہم ریلوے کے مرکز ہونے کی وجہ سے وائرس چین کے دیگر صوبوں تک پھیل گیا۔
20 جنوری کو چین نے ایک دن میں تقریباً 140 نئے کیسز کی اطلاع دی، جن میں بیجنگ میں 2 اور شینزین میں 1 کیس شامل تھا۔
بعد کے سرکاری اعداد و شمار کے مطابق، 20 جنوری 2020 تک 6,174 افراد میں علامات ظاہر ہوئیں۔ 26 مارچ تک، امریکہ کے کیسز چین اور اطالیہ سے زیادہ ہو گئے، جس سے وہ دنیا بھر میں سب سے زیادہ کیسز والے ملک بن گیا۔ 9 اپریل 2020 تک، دنیا بھر میں مجموعی طور پر 16 لاکھ سے زیادہ کیسز رپورٹ ہوئے، جبکہ 97 ہزار سے زیادہ اموات ہوئیں اور 364 ہزار سے زیادہ مریض صحت یاب ہوئے۔
دنیا بھر میں تقریباً 200 ممالک اور علاقوں نے کیسز کی رپورٹ کی ہیں۔
یورپی وبا کے باعث شینجن علاقے کے بہت سے ممالک نے آبادی کی آزادانہ منتقلی پر پابندیاں عائد کیں اور سرحدی نگرانی کا نظام قائم کیا۔
قومی کارروائیوں میں اقدامات شامل ہیں جیسے اسٹاک، جیسے عزلہ (جسے گھر بیٹھے رہنے کا حکم، گھر میں پناہ لینے کا حکم یا بلاک ڈاؤن کہا جاتا ہے) اور رات کے اوقات میں پابندیاں۔ 2 اپریل تک، امریکہ میں تقریباً 30 کروڑ افراد، جو آبادی کے تقریباً 90 فیصد ہیں، کسی قسم کے بلاک ڈاؤن میں تھے، فلپائن میں 5 کروڑ سے زیادہ افراد بلاک ڈاؤن میں تھے، جبکہ جنوبی افریقہ میں تقریباً 5.9 کروڑ افراد بلاک ڈاؤن میں تھے، اور بھارت میں 13 کروڑ افراد بلاک ڈاؤن میں تھے۔
26 مارچ کو دنیا بھر میں 1.7 بلین افراد کسی قسم کے لاک ڈاؤن میں تھے، اور دو دن بعد یہ تعداد بڑھ کر 2.6 بلین ہو گئی، جو دنیا بھر کی آبادی کا تقریباً تیسرا حصہ تھا۔
پہلی کیس کی تصدیق 2019 کے دسمبر 1 کو ووہان میں کی گئی تھی؛ ایک غیر تصدیق شدہ رپورٹ نے پہلے کیس کو نومبر 17 تک پیچھے کر دیا تھا۔
ڈاکٹر زھانگ جی سین نے 26 دسمبر کو ایک نامعلوم وجوہات کی وجہ سے پھیپھڑوں کے کئی ایک کیسز کی نشاندہی کی، اور اس کے اسپتال نے 27 دسمبر کو اس کی اطلاع واقعہ جنگ ہان کے بیماریوں کے روک تھام اور کنٹرول مرکز کو دی۔
27 دسمبر 2019 کو مریضوں کے نمونوں کے ابتدائی جینیاتی جائزے میں ایس ایس اے آر کے مشابہ کورونا وائرس کا ایک گروپ دریافت ہوا۔
وہان کے صحت کے محکمہ نے 31 دسمبر کو ایک اعلان جاری کیا،
اسی دن عالمی صحت تنظیم کو رپورٹ کیا گیا۔
ان اطلاعات جاری ہونے کے بعد، ووہان کے کچھ ڈاکٹرز کو کورونا وائرس کے پھیلاؤ کے بارے میں "غلط خبروں" کے پھیلانے کے الزام میں پولیس نے ڈانٹ دی۔
چین کے قومی صحت کے وزارت نے ابتدائی طور پر انسانوں کے درمیان پھیلنے کے "واضح ثبوت" نہ ہونے کا دعویٰ کیا۔
اواخر جنوری کے دوران، چینی حکومت نے ایک جارحانہ مہم شروع کی، جسے بعد میں چینی کمیونسٹ پارٹی کے سیکریٹری جنرل شی جن پنگ نے وائرس کے پھیلاؤ کو روکنے کی "عوامی جنگ" کہا۔
23 جنوری کو حکومت نے ووہان میں ایک صحت عامہ کی لکیر کے قیام کا اعلان کیا، جس کے تحت ووہان میں لوگوں کے داخل اور خارج ہونے پر پابندی عائد کر دی گئی۔ اس صحت عامہ کی لکیر کو بعد میں ہوبے کے دوسرے 15 شہروں تک بھی بڑھا دیا گیا، جس سے تقریباً 57 ملین افراد متاثر ہوئے، جسے "انسانی تاریخ کا سب سے بڑا عوامی تنہائی کا واقعہ" کہا جاتا ہے۔
شہر میں نجی گاڑیوں کے استعمال پر پابندی ہے۔
کئی مقامات نے چینی نیا سال (25 جنوری) کے جشن کو منسوخ کر دیا ہے۔
حکومتی اداروں نے ایک عارضی ہسپتال، یعنی فو شن شان ہسپتال کی تعمیر کا اعلان بھی کیا، جو 10 دنوں میں مکمل ہو کر استعمال کے لیے دے دیا گیا۔
بعد ازاں ایک اور ہسپتال، یی شن شان ہسپتال، مزید مریضوں کے علاج کے لیے تعمیر کیا گیا۔
چین نے ہسپتال کے علاوہ ووہان کے 14 دیگر مقامات، جیسے کنفرنس سینٹر اور اسٹیڈیم، کو کوویڈ-19 کے مریضوں کے لیے ہسپتال میں تبدیل کر دیا۔ 26 جنوری کو حکومت نے کوویڈ-19 کے پھیلاؤ کو روکنے کے لیے مزید اقدامات کیے، جن میں سفر کرنے والوں کو صحت کا بیان جمع کروانے اور نیا سال کی چھٹیاں بڑھانے شامل تھیں۔
ملک بھر کے جامعات اور سکولز بھی مکمل طور پر بند ہو گئے۔
چین کے ہانگ کانگ اور ماکاؤ علاقوں نے بھی کچھ اقدامات کیے ہیں، خاص طور پر سکولوں اور جامعات کے لیے۔
چین کے متعدد علاقوں میں گھر سے کام کرنے کے اقدامات کو نافذ کیا گیا ہے۔
صوبہ ہوبے کے علاوہ دیگر صوبوں میں بھی سفر کی پابندیاں عائد کی گئیں۔
