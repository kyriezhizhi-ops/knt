23 جنوری کو ووہان میں آمدورفت پر پابندی نافذ کرنے کے مرکزی حکام کے فیصلے کے جواب میں، عالمی ادارہ صحت کے نمائندہ گاودن گلیا نے کہا کہ اس کے بارے میں "یقیناً یہ وہ تجویز نہیں ہے جو عالمی ادارہ صحت ن
عالمی صحت کے ادارے کے ڈائریکٹر جنرل ٹیڈروس ادھانوم نے کہا کہ PHEIC کا خطرہ "عالمی پھیلاؤ کے خطرے" کی وجہ سے تھا، خاص طور پر کم اور درمیانے درجے کے آمدنی والے ممالک کے لیے جو مضبوط صحت کے نظام سے محروم ہیں۔
سفری پابندیوں کے نفاذ کے جواب میں، ڈیڈروس نے کہا کہ "بین الاقوامی سفر اور تجارت میں غیر ضروری خلل ڈالنے کا کوئی وجوہات نہیں ہے" اور یہ بھی کہ "عالمی ادارہ صحت تجارت اور روانی پر پابندی لگانے کی تجویز نہیں
5 فروری کو عالمی صحت تنظیم نے کم آمدنی والے ممالک میں حکمت عملیاتی تیاری کے لیے 675 ملین ڈالر کے تعاون کی درخواست کرتے ہوئے عالمی برادری سے اپیل کی، اس بات کو مدنظر رکھتے ہوئے کہ ان ممالک کو مدد کی ضرورت
ٹیڈروس نے مزید بیانات جاری کیے جس میں کہا کہ "ہم صرف اپنے کمزور ترین رابطے کے برابر طاقتور ہیں۔" اور عالمی برادری سے اپیل کی کہ "آج سرمایہ کاری کریں یا بعد میں زیادہ ادا کریں۔" 11 فروری کو عالمی ادارہ
اسی دن، تیڈروس نے کہا کہ متحدہ قومتوں کے سیکریٹری جنرل انٹیونیو گوٹیریس نے "پورے اقوام متحدہ کے نظام کی طاقت کو جواب دینے میں فراہم کرنے" کے لیے متفق ہو لیا تھا۔
ایک اقوام متحدہ کے بحران کے انتظام کی ٹیم کو نتیجے کے طور پر فعال کر دیا گیا، جس نے پورے اقوام متحدہ کے ردعمل کو منظم کرنے کی اجازت دی، جس کے بارے میں عالمی ادارہ صحت کا کہنا ہے کہ اس سے ان کو صحت کے جواب پر توجہ
14 فروری کو چین کے ساتھ ورلڈ ہیلتھ آرگنائزیشن (WHO) کی قیادت میں ایک مشترکہ مہم کو عمل میں لایا گیا تاکہ چین میں داخلی انتظام میں مدد کرنے اور "بیماری کی شدت اور وائرس کے پھیلاؤ کے امکان" کا جائزہ لین
ایران میں پھیل رہے وائرس کے واقعے کے جواب میں، عالمی ادارہ صحت نے وہاں صورتحال کا جائزہ لینے کے لیے ایک مشترکہ میشن ٹیم بھیجی۔ 28 فروری کو عالمی ادارہ صحت کے افسران نے کہا کہ عالمی سطح پر کورونا وائرس کے خطر
مائیک رائن، WHO کے صحت کی ایمرجنسی پروگرام کے ایگزیکٹو ڈائریکٹر، نے ایک بیان میں خبردار کیا کہ "یہ دنیا کے ہر حکومت کے لیے ایک حقیقت کا جائزہ ہے: جاگو۔"
یہ وائرس اپنے راستے پر ہو سکتا ہے اور آپ کو تیار رہنا ہوگا، اس بات کی تاکید کرتے ہوئے کہ مناسب جوابی اقدامات دنیا کو اس کے سب سے بڑے نقصان سے بچا سکتے ہیں۔
رائن نے مزید کہا کہ موجودہ اعداد و شمار کے مطابق صحت عامہ کے اہلکاروں کے لیے عالمی وبا کا اعلان کرنے کی ضرورت نہیں ہے، اور کہا کہ ایسی اعلان کا مطلب ہوگا کہ "ہم بنیادی طور پر قبول کررہے ہیں کہ دنیا کے ہر
11 مارچ کو، عالمی ادارہ صحت نے کوروناوائرس کے وبا کو عالمی وبا قرار دے دیا۔
ڈائریکٹر جنرل نے کہا کہ عالمی ادارہ صحت "پھیلاؤ اور شدت کے خطرناک درجے، اور بے حسی کے خطرناک درجے دونوں کے حوالے سے بہت پریشان ہے۔" عالمی ادارہ صحت کو وبا کے ناکافی انتظام کے طور پر دیکھے جانے کی وجہ سے ن
مخالفت میں ایک درخواست شامل تھی جس میں ورلڈ ہیلتھ آرگنائزیشن کے ڈائریکٹر جنرل ٹیڈروس ادھانوم کے استعفیٰ دینے کی مانگ تھی، جس پر 6 اپریل تک 733,000 افراد نے دستخط کیے۔
26 مارچ 2020 کو، ڈیڑھ دہائی سے زائد یونیسےو کے انسانی حقوق کے ماہرین نے کورونا وائرس کی وبا کے دوران ہر فرد کے حقوق کے احترام کی اہمیت پر زور دیا۔
ماہرین کے گروہ نے کہا کہ ہر ایک کو جان بچانے والے اقدامات کا حق حاصل ہے اور حکومت اس ذمہ داری پر قابض ہے۔
گروہ نے زور دے کر کہا کہ وسائل یا صحت کے بیمہ کی کمی کبھی بھی خاص گروہ کے خلاف تمیز کی وجوہات کے طور پر استعمال نہیں کی جانی چاہیے۔
ماہرین نے اس بات پر زور دیا کہ ہر فرد کو صحت کا حق حاصل ہے، جس میں معذور افراد، محدود اقلیتی گروہوں سے تعلق رکھنے والے افراد، عمر رسیدہ افراد، داخلی طور پر منتقل ہونے والے افراد، بے گھر لوگ، انتہائی غریب حالات میں
بین الاقوامی حکومتی ادارے کورونا وائرس کے بحران کے معاشی اور معاشرتی اثرات پر کام کر رہے ہیں۔
اقتصادی تعاون اور ترقی کی تنظیم نے دنیا بھر کے ممالک میں پالیسی کے جوابات کے بارے میں وقت پر اور جامع معلومات فراہم کرنے کے لیے ایک پلیٹ فارم کا آغاز کیا ہے، ساتھ ہی نقطہ نظر اور مشورے بھی فراہم کرتا ہے۔
صحت کے نظام اور دنیا کی معیشت کو مضبوط بنانے والی پالیسیوں سے لے کر لاک ڈاؤن اور سفر پر پابندیوں کے اثرات کو درست کرنے تک، ڈیجیٹل ہب میں ایک ملکی پالیسی ٹریکر شامل ہے، اور اس کا مقصد ممالک کو ایک دوسر
امریکہ، برطانیہ کے کابینہ آفس کے وزیر مائیکل گوف، اور برازیل کے صدر جائر بولسنارو کے بیٹے ایڈوآرڈو بولسنارو نے وبا کے انتظام کے معاملے میں چینی حکومت کی مذمت کی ہے، جو چین کے صوبہ ہوبی میں شروع ہوئی
چین کے کمیونسٹ پارٹی کے صوبائی سطح کے کئی انتظامیہ کے افسران کو مشرقی چین میں قرنطین کے انتظامات کے بارے میں غلطی کے باعث معطل کردیا گیا، جو ان علاقوں میں وبا کے حوالے سے سیاسی اداروں کے جواب کے خلاف ناپسندیدگ
کچھ تبصرہ کاروں کا خیال ہے کہ اس اقدام کا مقصد عوام کے غصے سے چینی کمیونسٹ پارٹی کے سیکریٹری جنرل شی جن پنگ کی حفاظت کرنا تھا، جو کوروناوائرس کے پھیلاؤ کے باعث تھا۔
کچھ چینی افسران، جیسے ژاؤ لی جین، نے ووہان میں کورونا وائرس کے پھیلاؤ کے ابتدائی اعتراف کو مسترد کر دیا، سازشی نظریات کے حق میں جن میں کوویڈ-19 کا آغاز امریکہ یا اٹلی سے ہونے کا دعویٰ ہ
ڈونلڈ ٹرمپ کی امریکی انتظامیہ نے کوروناوائرس کا ذکر "چینی وائرس" یا "ووہان وائرس" کے نام سے کیا ہے، کہتے ہوئے کہ چین کی "سرکاری سیلنسیش نے ایک وائرس کو ایک عالمی وبا میں تبدیل کر دیا ہے"، ج
ال دیلی بیس نے امریکی حکومت کا ایک کیبل حاصل کیا جس میں ایک رابطے کا منصوبہ پیش کیا گیا ہے، جس کے واضح اصول قومی سیکیورٹی کونسل میں موجود ہیں، اور اُس ترکیب کو "سب کچھ چین کے بارے میں ہے" کہ
ہمیں ہر ممکن طریقے سے یہ پیغام پھیلانے کی کوشش کرنے کا حکم دیا جا رہا ہے، جس میں پریس کانفرنسز اور ٹیلی ویژن پر ظاہر ہونا بھی شامل ہے۔ پولیٹیکو، فورین پالیسی، اور بلومبرگ جیسے ذرائع
یورپی یونین کے بیرونی سیاست کے سربراہ جوزیپ بوریل نے خبردار کیا کہ "ایک جغرافیائی سیاسی جزو ہے جس میں گھومنے کے ذریعے اور 'بہت کی سیاست' کے ذریعے اثر و رسوخ کی لڑائی شامل ہے۔"
بوریل نے اس کے علاوہ یہ بھی کہا کہ "چین پیغام کو بہت زور دے کر پھیلا رہا ہے کہ امریکہ کے برعکس وہ ایک ذمہ دار اور قابل اعتماد شراکت دار ہے۔"
چین نے امریکہ سے شام، وینیزویلا اور ایران پر عائد پابندیاں ختم کرنے کا بھی مطالبہ کیا ہے، جبکہ آخری دو ممالک کو امداد بھیجنے کی اطلاعات ہیں۔
جیک ما کی کیوبہ کو 100,000 ماسکوں کی نذر 3 اپریل کو امریکی پابندیوں کی وجہ سے روک دی گئی۔
امریکی حکام پر دوسرے ممالک کے لیے مخصوص امداد کو اپنے ملک میں منتقل کرنے کا بھی الزام لگایا گیا ہے۔
اور ماسک سے متعلق تنازعات کی اطلاعات موصول ہوئی ہیں دوسرے ممالک کے درمیان، جیسے جرمنی، آسٹریا اور سوئٹزرلینڈ؛ اور چیک جمہوریہ اور اٹلی۔
مزید برآں، ترکی نے اسپین کے لیے تیار وینٹی لیٹرز سینکڑوں ضبط کر لیے۔
مارچ کی ابتدا میں، اٹلی کی حکومت نے کورونا وائرس سے متاثر اٹلی کے ساتھ یورپی یونین کی عدم یکجہتی کی مذمت کی۔
موریشیو ماساری، اٹلی کے یورپی یونین کے سفیر، نے کہا کہ "صرف چین نے دو طرفہ طور پر جواب دیا۔"
بالکل، یہ یورپی یکجہتی کی اچھی علامت نہیں ہے۔
22 مارچ کو، اطالوی وزیر اعظم جوزیپے کونٹے کے ساتھ فون کال کے بعد، روس کے صدر ولادیمیر پوتن نے روسی فوج کا انتظام کیا تاکہ اٹلی کو فوجی طبی عملے، خصوصی جراثیم کش وسائلوں اور دیگر طبی آلات بھیجے جائیں۔
ایٹلی کے لا اسٹامپا اخبار نے ایک نامعلوم "اونچے سطح کے سیاسی ذریعے" کا حوالہ دیا جس نے کہا کہ روس کی امداد کا 80 فیصد اطالیہ کے لیے "بے کار ہے یا کم فائدہ مند تھا۔"
ذرائع نے روس پر ایک "جیوپولیٹیکل اور دوستی کے سیاسی مہم" شروع کرنے کا الزام لگایا۔
لومبارڈی کے صدر اٹیلیو فونٹانا اور اطالوی خارجہ وزیر لوئیجی ڈی مائیو نے میڈیا کی رپورٹوں کو مسترد کر دیا اور اپنی شکرگزاری کا اظہار کیا۔
روس نے طبی امداد لے کر ایک کارگو طیارہ ریاست ہائے متحدہ امریکہ بھیجا۔
کریملن کے ترجمان دمتری پیسکوف نے کہا کہ "امریکی ساتھیوں کی مدد پیش کرتے وقت، پوتن کچھ فرض کرتا ہے، اگر امریکی طبی آلات اور مواد کے تیارکنندگان کو گتھی ہو جائے گی تو وہ دوسری طرف بھی معاونت کر سک
منصوبہ بند نیٹو "ڈیفینڈر 2020" فوجی مشق جرمنی، پولینڈ اور بالٹک ممالک میں، سرد جنگ کے اختتام کے بعد سب سے بڑا نیٹو جنگی مشق، کم پیمانے پر منعقد کی جائے گی۔
نیوکلیئر ڈسآرمنمنٹ کی مہم کے جنرل سیکریٹری کیتھ ہڈسن نے ڈیفینڈر 2020 کے مشق کی مذمت کی: "حالیہ صحت عامہ کے بحران میں، یہ امریکی فوجیوں اور بہت سے شریک یورپی ممالک کے فوجی اہلکار
ایران کے صدر حسن روحانی نے 14 مارچ 2020 کو عالمی رہنماؤں کو ایک عوامی خط لکھا، جس میں مدد کی درخواست کی اور کہا کہ ان کا ملک وبا کے خلاف لڑائی میں دشواریوں کا سامنا کر رہا ہے، کیونکہ بین الاقوامی مارکی
سیاسی ماہرین کا خیال تھا کہ یہ 2020 کے صدارتی انتخابات میں ڈونلڈ ٹرمپ کے دوبارہ انتخاب کے امکانات کو منفی طور پر متاثر کر سکتا ہے۔ جاپان اور جنوبی کوریا کے درمیان دوطرفہ تعلقات وبا کی وجہ سے خراب ہوگ
جنوبی کوریا نے جاپان کے "غیر واضح اور بے حس قرنطینہ کے اقدامات" پر تنقید کی، جس کے بعد جاپان نے اعلان کیا کہ جنوبی کوریا سے آنے والے تمام افراد کو حکومت کے مقرر کردہ مقامات پر دو ہفتوں کے لیے قرنطینہ میں رکھا جائے
جنوبی کوریائی معاشرہ ابتدائی طور پر صدر مون جے این کی بحران کے ردعمل سے تقسیم تھا۔
کئی کوریائیوں نے درخواستیں دستخط کیں، جن میں مون کے استعفٰے کی مانگ کی گئی، جس کی وجوہات ان کے دعوے تھے کہ حکومت نے وبائی بیماری کے انتظام میں غلطی کی، یا پھر ان کے ردعمل کی تعریف کی گئی۔ عالمی و
کچھ تجزیہ کاروں نے تشویش کا اظہار کیا ہے کہ یہ حکومتوں کو طاقت پر قبضہ مضبوط کرنے میں مدد کر سکتا ہے۔
ہنگری میں اس کے پارلیمنٹ نے وزیر اعظم وکٹر اوربان کو غیر محدود مدت تک حکمرانی کے لیے حکم دینے کی اجازت دے دی، پارلیمنٹ اور انتخابات دونوں کو معطل کرنے کے ساتھ ساتھ وائرس اور بحران کے انتظام کے بارے میں غلط معلومات پھیلانے
کورونا وائرس کے پھیلنے کو کئی بار سپلائی کی کمی کے لیے ذمہ دار قرار دیا گیا ہے، جو عالمی سطح پر بیماریوں کے پھیلاؤ کے خلاف لڑائی میں سامان کے استعمال میں اضافے، خوف زدہ خریداری، اور فیکٹریوں اور لاج
امریکہ کے خوراک اور دوا کے ایجنسی نے خریداروں کی مانگ میں اضافے اور فراہم کنندگان کے نظام میں خلل کی وجہ سے ادویات اور طبی آلات کی کمی کے بارے میں انتباہ جاری کیے ہیں۔
کئی مقامات پر ڈر کے باعث خریداری کا بے قاعدہ اضافہ ہوا جس کے نتیجے میں گروسری کی اہم اشیاء جیسے کھانا، ٹوائلٹ پیپر اور بورلڈ واٹر سے ریفِریجیریٹرز خالی ہو گئے، اس سے فراہمی کی کمی پیدا
خاص طور پر ٹیکنالوجی صنعت نے الیکٹرانک اشیاء کی فراہمی میں تاخیر کے بارے میں انتباہ جاری کیا ہوا ہے۔
ورلڈ ہیلتھ آرگنائزیشن کے ڈائریکٹر جنرل تیڈروس ایڈھانوم کے مطابق، ذاتی حفاظتی سامان کی مانگ سو گنا بڑھ گئی ہے۔
اس طلب نے قیمتوں میں اضافہ کا باعث بنایا جو عام قیمت کے بیس گنا تک ہو سکتا ہے اور طبی اشیاء کی فراہمی میں چار سے چھ ماہ تک تاخیر پیدا کردی۔
اس نے دنیا بھر میں ذاتی حفاظتی سامان کی کمی بھی پیدا کر دی ہے، جبکہ WHO نے اس بات کی 경ت کی کہ اس سے صحت کی دیکھ بھال کرنے والے عملے کو خطرہ پیش آئے گا۔
آسٹریلیا میں وبا نے ڈائی گو خریداروں کو آسٹریلوی مصنوعات چین میں فروخت کرنے کا ایک نیا موقع فراہم کیا۔
یہ سرگرمی کچھ سوپر مارکیٹوں میں بچوں کے فارمولا کی کمی پیدا کر گئی ہے اور بعد میں آسٹریلوی حکومت نے اسے پابندی لگا دی۔ نارویل اٹلی اور ووہان علاقے میں COVID-19 کے کیسز کی بلند افزائش کے باوجود، ا
چین اور اٹلی کے اہم اشیاء کے ذخیرہ اندوزی اور غیر قانونی تجارت کے خلاف اٹھائے گئے اقدامات کامیاب رہے ہیں، جس نے یورپ اور شمالی امریکہ میں متوقع زبردست غذائی کمی سے بچا لیا۔
شمالی اٹلی، جس کی اہم زراعتی پیداوار ہے، میں کوئی بڑی کمی نہیں دیکھی گئی، لیکن صنعت کے نمائندوں کے مطابق قیمتیں بڑھ سکتی ہیں۔
خالی کھانے کی شیلفیں صرف عارضی طور پر دیکھی گئیں، یہ ووہان شہر میں بھی تھا، جبکہ چینی حکومتی افسران نے آبادی کو کافی غذائی افادیت فراہم کرنے کی یقین دہانی کروانے کے لیے سویا کے ذخائر جاری
ایٹلی میں بھی ایسے قوانین موجود ہیں جو کھانے کے پیدا کرنے والوں کو ایسی ہنگامی صورتحال کے لیے ذخائر رکھنے کی ضرورت بناتے ہیں۔
عالمی معاشی نقصان چین میں محسوس کیا گیا ہے: 16 مارچ کو ایک اخباری رپورٹ کے مطابق، 2020 کے پہلے دو ماہ میں چین کی معیشت کو بہت شدید نقصان پہنچا، جس کی وجہ حکومت کے وائرس کے پھیلاؤ کو روکنے کے
جیسے کہ مرکزی چین ایک بڑی معیشت اور تعمیراتی مرکز ہے، وائرل وبا کو عالمی معیشت کے لیے ایک بڑا مستحکم نہ کرنے والے خطرہ بننے کے طور پر دیکھا گیا ہے۔
ایکونومسٹ انٹیلیجنس یونٹ کی ایگاثے ڈیمارے نے پیش گوئی کی ہے کہ مارکیٹیں اب بھی ناہموار رہیں گی جب تک سببی نتائج پر ایک واضح تصویر ظاہر نہیں ہوتی۔
جنوری 2020 میں، کچھ تجزیہ کاروں نے وبا کے عالمی ترقی پر اقتصادی نتائج کا تخمینہ لگایا کہ یہ 2002–2004 کے ایس ایس اے ایس وبا کے مقابلے میں پیچھے رہ سکتا ہے۔
سٹ لوئس میں واشنگٹن یونیورسٹی کے ماہر کا ایک تخمینہ دنیا بھر کے سپلائی چین پر 300 بلین ڈالر سے زیادہ کا اثر ڈالا جو دو سال تک جاری رہ سکتا ہے۔
تیل کے نکالنے والے ممالک کے ادارے (اوپیک) کو رپورٹ کے مطابق تیل کی قیمتوں میں شدید کمی کے بعد، جس کی وجہ سے چین سے کم طلب تھی، "بھاگ دوڑ" میں مصروف دیکھا گیا۔
عالمی شیئر مارکیٹس 24 فروری کو مرکزی چین کے باہر COVID-19 کے کیسز کی کافی اضافہ کی وجہ سے گر گئیں۔
27 فروری کو کوروناوائرس کے پھیلاؤ کے بڑھتے خدشات کی وجہ سے، مختلف امریکی اسٹاک انڈیکسز میں ناسداک-100، ایس اینڈ پی 500 انڈیکس اور ڈاؤ جونز انڈسٹریل ایوریج سمیت، 2008 کے بعد سے سب سے زیاد
تینوں انڈیکس ہفتے کے آخر تک 10 فیصد سے زیادہ نیچے رہے۔
28 فروری کو اسکوپ ریٹنگز جی ایم بی ایچ نے چین کی قومی کریڈٹ ریٹنگ کو برقرار رکھا، لیکن منفی نظر ثانی برقرار رکھی۔
سٹاکس دوبارہ کورونا وائرس کے خوف پر مبنی گر گئے، سب سے بڑا گراﺅ 16 مارچ کو ہوا۔
بہت سے لوگوں کا خیال ہے کہ معاشی ریشہ ہونے کا امکان زیادہ ہے۔
معیشت دان محمد الاعریان نے مرکزی بینکوں اور ریاستوں کے وقت پر اور ایمر جنسی اقدامات کی تعریف کی۔
مرکزی بینکز 2008 کے مالیاتی تباہی کے مقابلے میں زیادہ تیزی سے ردِ عمل کر رہے ہیں۔
سیاحت سفر پر پابندیوں، عوامی جگہوں کے بند ہونے، سیر و سیاحت کے مقامات سمیت، اور دنیا بھر میں حکومتوں کے کسی بھی سفر کے خلاف مشورے کی وجہ سے ایک ایسا شعبہ ہے جسے سب سے زیادہ نقصان پہنچا ہے۔
نتیجے کے طور پر، کم طلب کی وجہ سے بہت سی ایئرلائنز، جن میں برطانوی ایئر ویز، چائنہ ایسٹرن ایئرلائنز اور کوئنٹس شامل ہیں، نے پروازیں منسوخ کر دی ہیں، جبکہ برطانوی علاقائی ائیرلائن فلائی بی تباہ
کروز لائن انڈسٹری پر اثرات اس سطح کے پہلے کبھی دیکھے نہیں گئے تھے۔
کئی ریلوے اسٹیشن اور فیری بندرگاہوں کو بند کر دیا گیا ہے۔
وبائی امراض چون یون کے دوران منسلک تھی، جو چینی نیا سال کے تعطیلات سے وابستہ ایک بڑا سفری موسم ہے۔
قومی اور علاقائی حکومتوں نے لوگوں کی بڑی تعداد والے کئی اجتماعات منسوخ کیے، جن میں سالانہ نیو سال کے تہوار بھی شامل تھے، جبکہ نجی کمپنیاں بھی اپنے دکانیں اور سیاحتی مقامات جیسے ہانگ کانگ ڈزنی لینڈ اور شانگھائ
بہت سارے ماہِ نو کے تقریبات اور سیاحتی جگہیں عوامی اجتماعات سے روکنے کے لیے بند کردی گئی ہیں، جن میں بیجنگ کا پرہیزگار شہر اور روایتی مندروں کے میلے شامل ہیں۔
چین کے 31 صوبوں، میونسپلٹیوں اور علاقوں میں سے 24 میں، اُتھارٹیز نے نیا سال کی چھٹیاں 10 فروری تک بڑھا دیں، اور زیادہ تر کام کے مقامات کو اس تاریخ تک دوبارہ کھولنے سے روک دیا۔
یہ خطے ملک کے جی ڈی پی کا 80 فیصد اور برآمدات کا 90 فیصد تک تصور کرتے تھے۔
ہانگ کانگ نے متعدی بیماریوں کے جواب کا درجہ اعلیٰ ترین سطح پر بڑھا دیا اور ہنگامی صورتحال کا اعلان کر دیا، سکول مارچ تک بند کر دیے اور نیا سال کی تقریبات منسوخ کر دیں۔ ریٹیل شعبہ عالمی سطح پر متاثر ہوا
یورپ اور لیٹن امریکہ میں ریٹیلرز کے دوروں میں 40 فیصد کمی آئی۔
شمالی امریکہ اور مشرق وسطی کے ریٹیلرز میں 50–60 فیصد کمی آئی۔
اس کے نتیجے میں مارچ میں فروری کے مقابلے میں خریداری کے مرکز میں پیدل چلنے والوں کی تعداد میں 33–43 فیصد کمی آئی۔
دنیا بھر کے شاپنگ مال کے مالکان نے مزید اقدامات عائد کیے، جن میں مزید صفائی و معطری کا انتظام، خریداری کرنے والوں کے درجہ حرارت کی جانچ کے لیے تھرمل اسکینرز کی تنصیب اور اجتماعات کے منسوخ ہونے کو شامل کیا گیا۔ لیٹ
جنوری اور فروری 2020 میں، ووہان میں وائرس کے عروج کے دوران، چین میں تقریباً 5 ملین لوگوں کو نوکریاں کھو دینی پڑیں۔
چین کے تقریباً 300 ملین رural مہاجر کارکنوں میں سے بہت سے اندری صوبوں میں گھر پر پھنسے ہوئے ہیں یا ہوبی صوبے میں پھنسے ہوئے ہیں۔ مارچ 2020 میں، 10 ملین سے زائد امریکی اپنے روزگار ک
کورونا وائرس کی وبا کے باعث ریاست ہائے متحدہ امریکہ میں 47 ملین نوکریاں خطرے میں پڑ سکتی ہیں اور بے روزگاری کی شرح 32 فیصد تک پہنچ سکتی ہے، سٹ لوئس کے فیڈرل ریزرو بینک کے تخمینوں کے مطابق
مارچ کے دوسرے آدھے کے دوران، 4 ملین فرانسیسی مزدوروں نے عارضی بے روزگاری کے فائدے کے لیے درخواست دی اور ایک ملین برطانوی کارکنوں نے عوامی ریلیف کے اسکیم کے لیے درخواست دی۔ جرمنی میں تقریباً آدھی لاک
جرمن مختصر وقت کی کام کی معاوضہ سکیم فرانس اور برطانیہ نے اپنالی ہے۔
