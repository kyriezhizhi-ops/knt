بۇ يىل نامراتلىقتىن قۇتۇلدۇرۇش جېڭىنىڭ ئاچقۇچلۇق يىلى ، چاغان ئاياقلىشىشى بىلەن غەربىي رايوندىكى ھەرقايسى ئۆلكىلەر نامراتلارنى يۆلەش خىزمىتىنى بەس-بەستە پۇختا ئىلگىرى سۈردى .
سۈرىيە دۆلەتلىك تېلېۋىزىيە ئىستانسىسىنىڭ 27-چېسىلادىكى خەۋىرىگە ئاساسلانغاندا ، روسىيە  تەشەببۇس قىلغان  دەمەشىقنىڭ شەرقىي شەھەر ئەتراپىدىكى  شەرقىي گۇتا رايۇنىدا ئىنسانپەرۋەرلىك يۈزىسىدىن ئۇرۇش توختىتىش شۇ كۈنى چۈشتىن بۇرۇن رەسمىي كۈچكە ئىگە بولغان ، ئەمما ئۇرۇش توختىتىش باشلانغاندىن كېيىن ھۆكۈمەتكە قارشى قوراللىقلار پۇقرالار تارقاقلاشتۇرۇلغان بىخەتەر كارىدورغا زەمبىرەك ئوقى ئېتىپ پۇقرالارنىڭ چېكىنىپ چىقىپ كېتىشىگە توسقۇنلۇق قىلغان .
پاناما قانال باشقۇرۇش ئىدارىسى 8-چېسىلا  ئۇقتۇرۇش چىقىرىپ، مۇنداق دېدى: نەچچە كۈندىن بۇيان ئۇدا قارا يامغۇر ياققاچقا، پاناما قانىلىدا شۇ كۈنى چۈشتىن باشلاپ قاتناش توختىتىلدى.
ئالدىنقى ئۈچ پەسىلدە، ئاخىرىقى ئىستىمال چىقىمىنىڭ ئىقتىسادنىڭ ئېشىشىغا قوشقان تۆھپىسى %64.5 كە يەتتى.
دۆلىتىمىزنىڭ كونا سانائەت بازىسى-جىلىننىڭ ئىگىلىك قۇرۇلمىسى بىرلا خىل بولغاچقا، بۇ خىل ئەھۋال خەلقئارا ئېھتىياج ئازىيىۋاتقان، ئىچكى ئىقتىسادنىڭ تىپىنى ئۆزگەرتىش  تېزلىشىۋاتقان ئەھۋالدا بارغانسېرى گەۋدىلىنىشكە باشلىدى .
ئوتتۇرا، غەربىي قىسىمدىكى ئاساسى بىر قەدەر ياخشى، شارائىتى ئاساسەن يار بېرىدىغان رايونلاردا ئاھالىنىڭ ئولتۇراق مۇھىتى سۈپىتى خېلى زور ئۆستۈرۈلۈپ، %90 ئەتراپىدىكى كەنتنىڭ تۇرمۇش ئەخلىتى مۇۋاپىق بىر تەرەپ قىلىنىدۇ، پاكىز ھاجەتخانىنىڭ ئومۇملىشىش نىسبىتى %85 كە يېتىدۇ، تۇرمۇش پاسكىنا سۈيىنى قالايمىقان قويۇپ بېرىش تىزگىنلىنىدۇ، يېزا يوللىرى كۆرىنەرلىك ياخشىلىنىدۇ.
تاقىۋەتسەك ئىشچى-خىزمەتچىلەرنى تارقاقلاشتۇرۇشقا 40-50 مىليون يۈەن مەبلەغ كېتىپ، پۈتكۈل تەمىنلەش زەنجىرىدە مەسىلە كۆرۈلىدۇ .تەمىنلەش سودىگەرلىرى قەرزنى سۈيلىسە قايتۇرالمايمىز .
قىسقىغىنە 10 ئاي ئىچىدە ، جىڭرۇڭ بازىرى  ئىگىلىك تىكلەش يىتىشتۈرۈش سۈپىسىدىن 13 نى جەلپ قىلدى ، كەلگۈسىدە بۇ يەردە چوڭ سانلىق مەلۇمات ، كۆچمە ئېنتېرنىت قاتارلىق تۆت چوڭ كەسىپ توپى شەكىللىنىدۇ .
ئېيتىشلارغا قارىغاندا ئەنگلىيىنىڭ بىر قىسىم رايونلىرىدىكى شەھەر مەموريىتى «پانچى بىلەن جۇدى»نىڭ رولىدا زوراۋانلىق چېكىدىن ئاشقان، بالىلارنىڭ كۆرۈشىگە ئۇيغۇن كەلمەيدۇ دېگەندەك ئەرىزلارنى تاپشۇرۇپ ئالغان.
ھەر دەرىجىلىك ھۆكۈمەتلەرنىڭ مەمۇرىيەتنى قانۇن بويىچە يۈرگۈزۈش ئىدىيىسى ئۈزلۈكسىز كۈچەيدى.گۇاڭدۇڭ فوشەندىكى يۇقۇرى سۈرئەتلىك تاشيول ساقچىلىرىنىڭ قانۇن ئىجرا قىلىشتا زورلۇق قىلىشى، جېڭجۇ ئۇنىۋېرسىتېتى قارمىقىدىكى 4-دوختۇرخانىنىڭ مەجبۇرىي چېقىلىشى قاتارلىق قانۇنغا خىلاپ مەمۇرىيەت يۈرگۈزۈش دېلولىرى تېز سۈرئەتتە بىر تەرەپ قىلىندى، ئالاقىدار جاۋابكارلارنىڭ مەسئۇلىيىتى سۈرۈشتۈرۈلدى ياكى قانۇن ئىجرا قىلىش قوشۇنىدىن چىقىرىۋېتىلدى.
جۈملىدىن [جۇڭگو-ئامېرىكا كېلىمات قوشما باياناتى] نىڭ تەسىرى ھەممىدىن چوڭ بولدى ، جۇڭگو ئەڭ چوڭ تەرەققى قىلىۋاتقان دۆلەت بولۇش سۈپىتىدە دۇنيادىكى ئەڭ چوڭ تەرەققى تاپقان دۆلەت بىلەن كېلىمات مەسىلىسىدە بىردەكلىك ھاسىل قىلىپ ، باشقا دۆلەتلەرگە ئۈلگە تىكلەپ بەردى.
مەسىلەن، 2013-يىلى 23-مارت سەئۇدى  ئەرەبىستانى سەھىيە مىنىستىرلىقى دۇنيا سەھىيە تەشكىلاتىغا بىر ئادەمنىڭ يېڭى تىپتىكى تاجىسىمان   ۋىرۇس بىلەن يوقۇملانغانلىقىغا ئىنىق دىئاگنوز   قويغانلىقىنى دوكلات قىلدى.
ئارشاڭ كەنتىگە كىرگەندە، 148 كىگىز ئۆينىڭ قاتار رەتلىك تىزىلغان، بىرنەچچە ئاتنىڭ يايلاقتا ئەركىن يايلاپ يۈرگەنلىكىنى كۆرىسىز.
بۈگۈن كەچ ، قۇتقۇزغۇچى خادىملار دوختۇرنىڭ پىكرى بويىچە ، قاپسىلىپ قالغانلارغا 3 ۋاخ  ئۇماچ يەتكۈزۈپ بەردى .
ھاكىمىيەت بېشىدىكى خەلق ھەرىكىتى ئىتتىپاقىنىڭ نامزاتى ساركوزى ٪31.1 ئاۋازغا ئېرىشكەن.
1998-يىلى جۇڭگو يېڭى جەنوبىي ئافرىقا بىلەن دىپلوماتىك مۇناسىۋەت ئورنىتىپ، جۇڭگو-جەنوبىي ئافرىقا مۇناسىۋېتىنىڭ يېڭى سەھىپىسىنى ئاچقان ئىدى.
2013-يىلىنىڭ ئاخىرىدا ، ۋۇشى شەھىرى خۈيشەن رايونلۇق خەلق سوت مەھكىمىسى شېرىكلىشىپ ئالدامچىلىق قىلىش دېلوسىنى قاراپ چىقتى، بۇ ئالدامچىلىق گۇروھىنىڭ ئالدامچىلىق ۋاستىسى ئەزەلدىن ئۇچراپ باقمىغان.
2-دۇنيا ئۇرۇشىدىن كېيىن، ھەر يىلى 10-ماينىڭ ئالدى كەينىدە، گېرمانىيە ھۆكۈمىتى خەلقنى كىتاپ كۆيدۈرۈش ۋەقەسىنى خاتىرلەشكە تەشكىللەپ، كۆپچىلىكنى تارىخىي ساۋاقنى ئېسىدە مەھكەم تۇتۇشقا ئەسكەرتىپ كەلمەكتە.
ئىراننىڭ ھەرقايسى جايلىرىدا ئىسرائىلىيىگە قارىشى نامايىش بولدى ، نەچچە مىڭ كىشى غەززاغا بېرىپ ئىسرائىلىيە ئارمىيىسىگە زەربە بېرىشكە تىزىملاتتى ، ئەمما ئاخبارات ۋاستىلىرى ئىراننىڭ ئالىي داھىيسى ھامىنېيىنىڭ پىدائىلارنىڭ غەززاغا بېرىشىغا يول قويماسلىق توغرىسىدا بۇيرۇق چۈشۈرگەنلىكىنى بىلدى .
ماس  بولماسلىق مەسىلىسى  شەھەرلەر بىلەن  يېزىلارنىڭ  تەرەققىياتى  دۈچ كېلۋىاتقان ئاساسلىق زىددىيەت ، ئەڭ كۆرۈنەرلىك پەرقلەردىن بىرى ئولتۇراقلىشىش مۇھىتىدا پەرق چوڭ ، بۇ مەسىلىدە ، بەزى جايلار بەزى تىرىشچانلىقلارنى كۆرسىتىپمۇ باقتى .
شۇنىڭدىن كېيىنكى بىر مەزگىلدە، جۇ شىئاڭ شاڭخەي، ۋۇخەن، گۇاڭجۇ، شياڭگاڭ قاتارلىق جايلاردا پارتىيە پائالىيىتى بىلەن پائال شۇغۇللانغان،1927- يىلى قىشتا، گۇاڭجۇ قوزغىلىڭىغا قاتناشقان.
« رەئىس شى جىنپىڭ يەر شارىلىشىۋاتقان دەۋىر ئۇچۇر ئىنقىلابىغا دۈچ كەلگەن مۇشۇنداق ۋەزىيەتتە، يەر شارىدىكى تور بوشلۇقى ئېلىپ كەلگەن پۇرسەت ۋە خىرىستىن قانداق پايدىلىنىش توغرىسىدا، جۇڭگونىڭ تور بىخەتەرلىكى ۋە ئۇچۇرلاشتۇرۇش ئىستراتېگىيەسىنى ئىخچام، ئېنىق تەسۋىرلەپ بەردى»
ئەمىلىيەتتە ئامېرىكا دۇنيادا تۇنجى بولۇپ تور ئۇرۇشى ئۇقۇمىنى باشلىغان دۆلەت، شۇنداقلا تۇنجى بولۇپ رەسمي ئۇرۇشقا ئىشلەتكەن دۆلەت، بەزى تاراتقۇلار ئامېرىكىدىكى خاككىرلار قىسمىدىكىلەرنىڭ  يۈز مىڭدىن ئاشىدىغانلىقىنى ئاشكارلىدى.
« مېنىڭچە ياپۇنىيە بىلەن ئامېرىكىنىڭ بىخەتەرلىكىنى قوغدىشى   ناھايىتى مۇھىم، لېكىن ياپۇنىيە-ئامېرىكا بىخەتەرلىكىنى قوغداشقىلا تايىنىشقا بولمايدۇ ، ياپۇنىيە جۇڭگو ۋە ئاسىيادىكى باشقا دۆلەتلەر بىلەن ئورتاق گەۋدە ، مەسلەن ئىقتىساد قاتلىمىدىكى ئورتاق گەۋدە قۇرۇشى كېرەك ، شۇندىلا شەرقى ئاسىيا ۋە جۇڭگونىڭ تەرەققىياتى ياپۇنىيە تەرەققىياتىغا تۈرتكە بولالايدۇ.»
خۇاڭ جېن  جۇڭگو كوممۇنىستىك پارتىيىسىنىڭ مۇنەۋۋەر ئەزاسى ،  ئۇزاق سىناقلاردىن ئۆتكەن سادىق كوممۇنىزىم جەڭچىسى ،  پرولېتارىيات ئىنقىلاپچىسى ،  كۆزگە كۆرۈنگەن دىپلومات ،  پارتىيىمىز ، ئارمىيىمىزنىڭ مۇنەۋۋەر سىياسىي خىزمەتچىسى ۋە مەدەنىيەت خىزمىتى ساھەسىدىكى  رەھبىرى .
ئالدىنقى  ئەسىرنىڭ 60-يىللىرىدا ئىشلەنگەن ئامېرىكىنىڭ بۇ فانتازىيەلىك فىلىمىدە يۇمۇرۇستىك، ئاق كۆڭۈل مارس ئادىمى مارتىن كىشلەرگە چوڭقۇر تەسىرى قالدۇرغان.
دۇنيا ئىقتىسادى كرزىسقا دۈچ كېلىۋاتقان پەيتتە ئېنتىل شىركىتىنىڭ بۇ يىل بىرىنچى پەسىلدىكى پايدىسى 647مىليون دوللارغا يەتكەن ،بۇ  ھەربىر پايدىن 11سېنىت پايدا ئالغان بىلەن باراۋەر .
20 يىلدىن بۇيان ، جاڭ نىڭ نۇرغۇن رىكورت ياراتتى ، 7 ئاي ئىش ئورنىدا تۇردى ، 23 ياشتا قەشقەر ئۆلچەش كونترول قىلىش پونكىتىنىڭ ئەڭ ياش نەخ مەيدان قوماندانى بولدى ، 5 يىلدا 5 قېتىم مۇقەددەس كېمىنى ئۆلچەش كونترول قىلىشنى خاتاسىز ئورۇنلىدى .
بۇ كۆرۈنۈش جىياڭشى ئۆلكىسىنىڭ نەنچاڭ شەھەرلىك يېزا ئىگىلىك بانكىسى شياڭخۇ   تارماقىنىڭ ئاپتوماتىك پۇل بەرگۈسىدىن تارتىلغان سۈرەت، سۈرەتتە كۆرسىتىلىشچە، يېرىم كىچە بولسىلا بىرەيلەن كېلىپ پۇل ئالغان، بۇنداق ئىش بىر قانچە كۈن داۋاملاشقان.
ئېلىمىزنىڭ تۇنجى  تۆت كىشلىك ئايرۇپىلانى _     DA40 بەلگىلىك ئايرۇپىلان  يېقىندا شەندۇڭ بىنجۇدا تۈركۈملەپ ئىشلەپچىقىرىلىشقا باشلىدى .
شىزاڭ ئاپتونوم رايۇنىمىزدا قاپلىق قۇرۇت كېسەللىكىنىڭ يۈز بېرىش نسىپىتى %1.66 ، ھېسابلىساق ئاپتونوم رايۇن بويىچە 49900 ئادەم مۇشۇ كېسەللىككە گىرىپتار بولغان ، دېڭىز يۈزىدىن ئىگىز رايۇنلاردا بۇ كېسەللىكنىڭ يۈز بېرىش نىسپىتى يۇقۇرى .
ئىككى دۆلەت سىتىراتىگىيە يۈكسەكلىك  ۋە يىراققا نەزەر تاشلار نۇقتىسىدا تۇرۇپ ئىككى دۆلەت مۇناسىۋىتىگە دىققەت قىلىدۇ ۋە ئۇنى ئىگىلەيدۇ ، يېڭى ئەسىردىكى تۈرلۈك دۇنياۋى رىقابەتلەرگە ئورتاق تاقابىل تۇرىدۇ ، جۇڭگو – ئامېرىكا مۇناسىۋىتىنىڭ ئومۇميۈزلۈك تەرەققىياتىنى ئىلگىرى سۈرىدۇ .
باش شۇجى ئۇنىڭ ئۆيىدە 20يىل ئىلگىرىكى ئىشنى ئەسلىدى، 1996-يىلى فۇجيەن نىڭشىياغا نىشانلىق ياردەم قىلىدىغان رەھبەرلىك گۇرۇپپىسى قۇرغاندا شى جىنپىڭ گۇرۇپپا باشلىقى بولغان.
قاتناش ترانسىپورت مىنىستىرلىقى ، گوڭئەن مىنىستىرلىقى يېقىندا بىرلەشمە ئوختۇرۇش چىقىرىپ ، تاكسى شوپىرلىرى ، توردا چاقىرىدىغان تاكسى شوپىرلىرىنىڭ ئارقا كۆرۈنۈشىنى تەكشۈرۈش، نازارەت قىلىپ باشقۇرۇش خىزمىتىنى ياخشى ئىشلەشنى تەلەپ قىلدى .
ھەر سېونتتا ئىككى مىڭ يۇەن قىممىتىدىكى مال چىگرا ئېغىزىدىن كىرىپ-چىقىدۇ.
بارلىق خىزمەتچىسى 300دىن ئاشىدۇ، ئۇلارنىڭ ئىچىدە 20دىن كۆپرەكى بىزنىڭ بۇ يەردىن كەلدى .
دۆلەتنىڭ ھازىر بېيجىڭ، تيەنجىن، خېبىينىڭ تەرەققىياتىنى بىر گەۋدىلەشتۈرۈشتەك ئىستىراتېگىيەلىك تەرەققىيات سۇپىسى بار، بىز بۇ سۇپىغا تايانساق  تىجارىتىمىز تېخىمۇ ياخشى بولىدۇ.
تەنھەرىكەتچىلەر مەملىكەتتىكى 31 ئۆلكە ، ئاپتونوم رايۇن ، شەھەردىن كەلگەن ، ئۇلارنىڭ ئىچىدىكى 261 ئادەم بېيجىڭ ئولىمپىك تەنھەرىكەت موسابىقىسىغا قاتناشقان ، 35 ئولىمپىك چىمپىيۇنىنى ئۆز ئىچىگە ئالىدۇ .
بۇنداق ئەسكەرلەر قانچە كۆپ بولسا، بىز پۇقرالارنىڭ تۇرمۇشى شۇنچە خاتىرجەم بولىدۇ دۆلىتىمىزنىڭ ئىناق ،تىنچ كەيپىياتى تېخىمۇ قويۇق بولىدۇ.
ئەر: 2014- يىلى 8- ئاينىڭ 7- كۈنى، ئادىل قاتارلىقلار 1200 كىلومېتر يولنى بېسىپ ، 10 مىڭ جىڭ سوقماقنى ئېلىپ ئاپەت رايونى لۇديەنگە يېتىپ كەلدى .
ئەنئەنىۋى يېزا ئىگىلىكىگە تايانغاندا، بۇ يەردىكى دېھقانلار كىرىمىنى ئاشۇرالمايدۇ، جاڭ كەيچۈەن كىرىمىنى ئاشۇرۇش ئۈچۈن، كىچىك چېغىدىلا شەرقىي جەنۇبتىكى دېڭىز بويى رايونلىرىغا بېرىپ ئىشلىدى، 40 يېشىدا يۇرتىغا قايتىپ يېزا ئىگىلىك قوشۇمچە مەھسۇلاتلىرى سودىسى بىلەن شۇغۇللاندى، تۇرمۇشى يەر تېرىغانغا قارىغاندا سەل ياخشىلاندى، لېكىن بېيىيالمىدى.
جەنۇبىي سۇدان ئارمىيەسىنىڭ باياناتچىسى نۆۋەتتە بور ھۆكۈمەتكە قارشى قۇراللىقلار تەرىپىدىن كونترۇل قىلىنغانلىقىنى، بۇ قېتىملىق ھوجۇمنى ھۆكۈمەتكە قارشى قۇراللىقلار سادىر قىلغانلىقىنى ئېيتتى.
داۋالاش، سەھىيە، دورا ئىسلاھاتىنى داۋاملىق ئىلگىرى سۈرۈپ، يىمەكلىك بىخەتەرلىكىگە كاپالەتلىك قىلىش، ئىجتىمائىي قۇتقۇزۇش ۋاقىتلىق چارىسىنى ياخشى يولغا قويۇپ، يېزا سۇ بىخەتەرلىكى، نامراتلارنى يۆلەش-ئازايتىش قاتارلىق نىشانلارنى تاماملاش، ئاساسقا كاپالەتلىك قىلىش، تۆۋەن چەكتىن چۈشۈپ كەتمەسلىكتىن ئىبارەت خەلق تۇرمۇشى «بىخەتەرلىك تورى»نى مۇستەھكەملەش كېرەك.
شۇنىڭ بىلەن بىر ۋاقىتتا، شەندۇڭ، لياۋنىڭ، خېبېي قاتارلىق سەككىز ئۆلكە ئاپتونوم رايون بىرلا ۋاقىتتا كىچىك تىپتىكى ئوت ئېلېكتىر ئىستانسىسىدىن 20نى شاللىدى، بۇنىڭ ئومۇمى كۆلىمى ئىككى مىليون 373مىڭ كىلوۋات سائەتكە يېتىدۇ.
دۆلەت رەئىسى خۇجىنتاۋ بۈگۈن جىبۇتى جۇمھۇرىيىتىنىڭ زۇڭتۇڭى ئىسمايىل ئۆمەر  گوللەھ بىلەن ئۆزئارا تەبرىك تېلېگراممىسى يوللاپ ، ئىككى دۆلەت  دىپلوماتىىڭ مۇناسىۋەت ئورناتقانلىقىنىڭ   30 يىللىقىنى تەبرىكلىدى .
مۇقەددەس كېمە 11-ناملىق ئالەم كېمىسى بىلەن ئەرىش ئوردىسى 2-ناملىق ئالەم تەجرىبىخانىسى مۇۋەپپىقىيەتلىك ئايرىلدى، ئىككى ئالەم ئۇچقۇچىسى پات ئارىدا يەر شارىغا قايتىپ كېلىدۇ.
دۆلەت ئىنىرگىيە ئىدارىسى 2017-يىلى 1-ئايدىن 11-ئايغىچە ئىلىمىزنىڭ يورۇقلۇق ۋولت توك تارقىتىش مىقدارىنىڭ 106مىلىيارد 900مىلىيون كېلوۋات سائەتكە يېتىپ، بۇلتۇرقى ئوخشاش مەزگىلدىكىدىن %72 ئېشىپ،  يوروقلۇق ۋولت يىللىق  توك تارقىتىش مىقدارىنىڭ  100مىلىيارد كېلوۋات سائەتتىن ئاشقانلىقىنى ئېلان قىلدى، بۇ 33مىلىيون توننا ئۆلچەملىك كۆمۈرنىڭ ئورنىنى ئېلىپ، 93مىلىيون توننا كاربون 4- ئوكسىدنى ئاز قويۇپ بەرگەنگە باراۋەر.
«بىز ئۆز مەيلىمىزچە ئىش كۆرسەك بولمايدۇ، گەرچە بىزنىڭ ئارزۇيىمىز كۈچلۈك بولسىمۇ لېكىن بىز جەزمەن ئىقتىدارىمىزنى تونۇپ يېتىشىمىز كېرەك.»
يىرىك پىلان پىروگراممىسىنى تۈزۈش گۇرۇپپىسى پىروگراممىنى قانداق تۈزۈش ، قانداق يېڭىلىق يارىتىش توغرىسىدا كۆپ قېتىم يىغىن ئېچىپ مۇزاكىرە قىلىپ ، گوۋۇيۈەنگە پروگراممىنىڭ تېزىس لايىھەسىنى سۇندى .كېيىنكى قەدەمدە تېزىس  تەپسىلىي مۇزاكىرە قىلىندى .
ئاڭلاشلارغا قارىغاندا ، بۇ مەيخانىنى 80 پىدائىي 9 ئايدا پۈتتۈرگەن .ئۇلار بۇ ئارقىلىق كىشىلەرنى شاراپقا بېرىلمەسلىككە ئاگاھلاندۇرماقچى بولغان .
1-چېسىلا ئەسەبىي تەشكىلات ئىراقنىڭ جەنۇبىي قىسمىدا ئىككى قېتىم ئاپتوموبىلبومبا بىلەن ھۇجۇم قىلدى، ئاز بولغاندىمۇ 32 ئادەم ئۆلۈپ 75 ئادەم يارىلاندى.
سەئۇدى ئەرەبىستانى جۇڭگو بىلەن بولغان مۇناسىۋەتنى تەرەققي قىلدۇرۇشقا  يۈكسەك ئەھمىيەت بېرىدۇ، جۇڭگو بىلەن ھەرقايسى ساھەلەردىكى تەڭ مەنپەئەتلىنىش   ۋە  خادىملار  ئالاقىسىنى چوڭقۇرلاشتۇرۇشنى خالايدۇ، جۇڭگو كارخانىلىرىنىڭ سەئۇدى ئەرەبىستانغا كېلىپ مەبلەغ سېلىشنى قارشى ئالىدۇ.
مۇخبىر بىلەن تازلىق ئىشچىسى  پىڭجىياڭ ناھىيىلىك دوختۇرخانىغا ئېلىپ بېرىلدى ، تەكشۈرۈشتە ، جاۋ شىنىڭ پىشانىسىنىڭ سول تەرىپى يارىلىنىپ ، يىنىك زەخمىلەنگەن ، باشقا كىشىلەردە ۋاقتىنچە روشەن يارا بايقالمىغان.
كۆلىمى  1210كۇۋادىرات كېلومىتىر كېلىدىغان پۇدۇڭدا 5مىليۇن 520مىڭ دائىمىي تۇرۇشلۇق نوپۇس بار، پۇدۇڭلىقلار سەپەرگە چىقسۇن ياكى ئۆيىدە ئولتۇرسۇن ئىسلاھاتنىڭ پاراۋانلىقىدىن ھوزۇرلىنىدۇ.
چۈەنشاشىن بازىرى چىزاۋ كەنتىدىكى يېشى 70كە ئۇلىشىپ قالغان دېھقان چېن بوۋاي ئەتىگەن ئۆيىدىن چىقىپ پىيادە بەش مىنۇت مېڭىپ يېقىن ئەتراپتىكى مۇلازىمەت پونكىتىغا كېلىپ  كېسەل كۆرسىتىش دەپتىرى بىجىرىشكە ئىلتىماس سۇندى.
بېيجىڭ ساقچىلىرى يېقىندا 21 ئۆلكىگە چېتىشلىق توردا قىمار ئويناش دېلوسىنى پاش قىلدى، دېلوغا چېتىشلىق سومما 2 مىليارد 100 مىليون يۈەنگە يېتىدۇ، ھازىر دېلوغا چېتىشلىق 120 دىن ئارتۇق ئادەم توختىتىپ قويۇلدى.
يىغىندا 12-نۆۋەتلىك مەملىكەتلىك خەلق قۇرۇلتىيى دائىمىي كومىتېتى 1-يىغىنىنى 19-مارت چۈشتىن بۇرۇن بېيجىڭدا ئېچىش قارار قىلىندى .
فانتازىيەلىك فىلىملەردە ، سىز بىر خىل ئاجايىپ ماشىنىنى يەنى ئادەم ئىچىگە كىرسە تويۇقسىز يوقاپ كىتىپ ، كېيىن تېزدىن يەنە بىر يىراق ماكاندا پەيدا بولغانلىقىنى كۆرگەن بولۇشىڭىز مۇمكىن ،   كۋانت دۇنياسىدا ، بۇ خىل ماكاندىن ھالقىش راسلا رىياللىققا ئايلاندۇرالامدۇ ؟
جۇڭگو كوممونىستىك پارتىيەسى  قۇرۇلغاندىن كېيىن   جۇڭخۇا مىللىتىنىڭ ئۇلۇغ گۈللىنىشىدىن ئىبارەت جۇڭگو ئارزۇسىنى ئىشقا ئاشۇرۇشتەك تارىخىي بۇرۇچنى زېممىسىگە ئېلىشتا ھەققانىيەت يولىدىن قايتماي، ئۇزۇن مەزگىل  جاپا-مۇشەققەتلەرنى باشتىن ئۆتكۈزۈپ، داۋاملىق كۈرەش قىلىپ،   ئوخشىمىغان دەۋردە  ئاشۇ  دەۋرگە خاس سەھىپىنى يازدى.
ئۇلار نىمە بولدۇڭ، دېدى، مەندىن بولامدىكەن دەپ سورىدى، مەن بولىدىكەن دېدىم، ئۇلار كۈلۈشۈپ كەتتى.
ئەمما، ئۇنىڭ يىلان بىلەن تەڭ ئۇسسۇل ئويناۋاتقىنىغا نۇرغۇن يىل  بولدى، دېمەك سالىھنىڭ باشقىلاردىن ئۈستۈن تۇرىدىغان يەرلىرى بار.
مەن بۇ يەرگە كىلىپ يا باشقىلارنىڭ سۆزىنى چۈشەنمىدىم، يا قىلىۋاتقان ئىشىنى بىلەلمىدىم، شۇنىڭ بىلەن ئۆزۈمنى تاشقى پىلانىتتىن كىلىپ قالغاندەك ھېس قىلدىم،
شى جىنپىڭ پېنىلادىن چىچېن- ئىتزاي خارابىسىغا ئالاقىدار ئەھۋاللارنى ئىگىلىدى، پېنىلا شى جىنپىڭغا مايا مەدەنىيىتىنىڭ مىكسىكا مەدەنىيىتىگە كۆرسەتكەن تەسىرى شۇنداقلا خارابىنى قوغداش ۋە رىمۇنت  قىلىش خىزمىتىنى تونۇشتۇردى.
3-ئاينىڭ 25-كۈنى سەنشى جىنچېڭنىڭ قورۇلۇش يولىدىكى ئاق تېرەكلەر توك ھەرىسىنىڭ ئاۋازى ئىچىدە يەرگە يىقىلدى، كېسىۋېتىلگەن دەرەخ كۆتەكلىرى يالىڭاچىلىنىپ قالدى، بۇلارنىڭ ئىچىدە توملىقى 80-70 سانتىمېتىر كېلىدىغان دەرەخلەر بار ئىدى، قورۇلۇش يولىدىكى ئاق تېرەكلەرنىڭ كېسىۋېتىلىشى شەھەر ئاھالىلىرى ئارىسىدا كۈچلۈك ئىنكاس قوزغىدى.
« شى جىنپىڭنىڭ يېڭى دەۋر جوڭگۇچە سوتسىيالىزم ئىدىيەسىنىڭ يېتەكچىلىكىدە -- يېڭى دەۋر، يېڭى  نەتىجە ، يېڭى سەھىپە » ناملىق چاتما خەۋەردە بۈگۈن  گۇاڭدوڭ ئۆلكىسىنىڭ  يېڭى ، تېخىمۇ  زور نەتىجە   بىلەن ئېسلاھات  ئېچىۋىتىشنىڭ يېڭى ۋەزىيىتىنى  يارىتىش ئۈچۈن تۈزۈلمە مىخانىزم توسۇقىنى تۈگەتكەنلىكىنى  تونۇشتۇرىمىز .
ئويۇشتۇرغۇچى تەرەپ كىشىلەرنىڭ بۇنداق ئىشنى باشتىن كەچۈرىشى ئارقىلىق "ئوغرىلىقچە ئۆتۈش"نىڭ خەتىرىنى بىلىشىنى ئۈمىد قىلىدىغانلىقىنى ئېيتتى.
ئىككىنچى ، ماكرولۇق ئىقتىسادىي سىياسەتنى كۈچەيتىپ  ۋە تەرەققىيات ئىستىراتىگىيىسىنى ماسلاشتۇرۇپ  ، مالىيە – باج ، پۇل ، كەسىپ ، سودا سىياسىتى قاتارلىق جەھەتلەردىكى   ئالاقىنى كۈچەيتسەك .
دۆلەت ئۆلچەم كومىتېتى بۈگۈن «مەھەللىدىكى ياشانغانلاردىن كۈندۈزى خەۋەر ئېلىش مەركىزىنىڭ ئەسلىھە ئۈسكۈنىلىرىنى ئورۇنلاشتۇرۇش» قاتارلىق 315تۈرلۈك دۆلەت ئۆلچىمىنى ئېلان قىلدى، بۇلار زامانۋىلاشقان يېزا ئىگىلىكى، ساغلاملىق، بىخەتەرلىك قاتارلىق جەھەتلەرگە چېتىلىدىغان بولۇپ، كېلەر يىلى كەينى-كەينىدىن يولغا قويۇلىدۇ.
2009-يىلى شىزاڭ ئاپتونوم رايونى ئىجتىمائىي ئىستېمال بۇيۇملىرىنىڭ پارچە سېتىلىش ئومۇمىي سوممىسىنى 15 مىليارد 500 مىليون يۈەنگە يەتكۈزۈپ، ئالدىنقى يىلىدىكىدىن ٪20.1 ئاشۇردى.
تەييارلىق سايلام باشلىنىشتىن ئىلگىرى دېموكراتلار پارتىيىسى بىلەن جۇمھۇرىيەتچىلەر پارتىيىسىنىڭ سايلام رىقابىتىگە قاتناشقۇچىلىرى ئىئوۋا شىتاتىنىڭ ھەرقايسى جايلىرىدا  توختىماستىن سەييارە سايلام پائالىيىتى ئۆتكۈزدى.
گېرمانىيە ئىچكى كابېنتى 1-چېسىلا فېدىراتىسيە دۆلەت مۇداپىئە  ئارمىيەسىنىڭ ئەسەبىي تەشكىلاتلارغا زەربە بېرىش ھەرىكىتىگە قاتنىشىشىنى تەستىقلىدى .
2010-يىلدىن 2012-يىلغىچە بولغان ئارلىقتا بىز يەنە ئىستاستىكا قىلدۇق ، ئومۇمىي مەھسۇلات مىقدارى ئازايمىغان ، لېكىن بۇ نىسبەت ئالمىشىپ  قالغان ، بىۋاستە يىگىلى بولىدىغان ياكى ئاتالمىش بىرئاز ياخشى بولغان سۇ مەھسۇلاتلىرى ، تەخمىنەن ٪31 ئەتىراپىدا بولغان .
« بۇ يەرگە كۆچۈپ كىلىپ بەك ياخشى بولدى ، يوللىرى تۈز ، كوچا چىراقلىرى بار ئىكەن ، بىز بۇ يەردە بىر كىچىك دۇكان ئاچتۇق ،  ئايدا يەنە نەچچە مىڭ يۇەن كىرىم قىلالايمىز .»
بۇ يەر ئۇزۇن يىل نامرات ھالەتتە تۇرغاچقا يول ياسىغۇدەك پۇل يوق ئىدى، يول بولمىغاچقا، نامراتلىقتىن قۇتۇلۇپ كېتەلمىدى، يول ياساش نامراتلىقتىن قۇتۇلۇپ بېيىشتىكى مۇھىم ئاچقۇچ بولۇپ قالدى.
بۈگۈن كەچ يەر يۈزىدىكى  خىزمەتچى خادىملار مۇقەددەس كېمە 11- ناملىق ئالەم كېمىسىنى ئاخىرقى قىتىم ئوربىتىدا كونتۇرۇل قىلىدۇ.
ئۇنداقتا كەلگۈسىدىكى ئۇرۇشلار راستىنلا مۇشۇنداق ماشىنا ئۇرۇشىغا ئايلىنىپ كېتەمدۇ؟
ئەمگەك بىلەن تەربىيەلەش تۈزۈمى ئېلىمىز ئۆتكەن ئەسىرنىڭ 50- يىللىرىدىن باشلاپ يولغا قويغان بىر خىل قانۇن ئىجرا قىلىش ۋاستىسى .
خېرىدارلارنى جەلپ قىلىش ئۈچۈن ئەنگىلىيىدىكى ئاپتوموبىل سېتىش سودىگەرلىرى كىشىلەرنى ھەيران قالدۇرىدىغان بىرنى ئالسا بىرنى سوۋغا قىلىدىغان ئېتىبار بېرىش تەدبىرىنى ئوتتۇرىغا چىقاردى.
بىرلىكسەپ بۆلۈمىنىڭ مەسئۇلى مۇنداق دېدى: << پىكىر >> دە، سودا- سانائەتچىلەر بىرلەشمىلىرىنىڭ خىزمىتى  پارتىيەنىڭ بىرلىكسەپ خىزمىتى ۋە ئىقتىسادىي خىزمەتلىرىنىڭ مۇھىم مەزمۇنى ئىكەنلىكى تەكىتىلىنىپ، سودا- سانائەتچىلەر بىرلەشمىلىرى  خىزمىتىنىڭ پارتىيە ۋە دۆلەتنىڭ خىزمەت ئومۇميىلىقىدىكى مۇھىم ئورنى ئايدىڭلاشتۇرۇلدى.
يېڭى ۋەزىيەتتە، ئىككى تەرەپ پۇرسەتنى چىڭ تۇتۇپ، يۆنىلىش بويىچە ئالغا ئىلگىرلەپ، ئۆز ئارا چۈشىنىش ۋە تەڭ مەنپەئەتلىنىش ھەمكارلىقلىرىنى ئىلگىرى سۈرۈپ، ئىككى دۆلەتنىڭ ئومۇمىيۈزلۈك ھەمكارلىق مۇناسىۋىتىنى ئۈزلۈكسىز يېڭى پەللىگە كۆتىرىشنى تېزلىتىشىمىز كېرەك.
1925- يىلنىڭ بېشىدا، جۇ شىئاڭ يۈن دەييىڭنىڭ تونۇشتۇرۇشى بىلەن جۇڭگو كوممۇنىستىك پارتىيىسىگە ئەزا بولغان.
بۇلغارىيە تېخىمۇ كۆپ جوڭگو كارخانىلىرىنىڭ بۇلغارىيە كېلىپ مەبلەغ سېلىپ، كەسپىنى گۈللەندۈرۈپ ، ئىككى تەرەپ مۇناسىۋىتى ۋە ، ئوتتۇرا ، شەرقىي ياۋروپا دۆلەتلىرى بىلەن جوڭگونىڭ ھەمكارلىقىنى ئورتاق ئىلگىرى سۈرۈشتە يېڭى تەرەققىياتلارنى قولغا كەلتۈرۈشىنى قارشى ئالىدۇ .
بۇ بىر يىلدا ئەشيار ئوبوروتى كارخانىلىرىنىڭ يەتكۈزۈش تورى  مەملىكىتىمىزنىڭ %95  رايون، ناھىيەسىنى قاپلىدى ، بۇ يىل توردا مال سېتىۋېلىش مەملىكىتىمىزنىڭ   8مىڭدىن ئارتۇق يېزا ، كەنتكىچە كېڭەيدى .
ئۇ مۇنداق تەكىتلىدى: ئىسلاھات، ئېچىۋېتىش يولغا قويۇلغان 40 يىلدا جۇڭگو خەلقى جۇڭگو كوممۇنىستىك پارتىيەسىنىڭ كۈچلۈك رەھبەرلىكىدە جاپا- مۇشەققەتكە چىداپ، قەيسەرلىك بىلەن كۈرەش قىلىپ، ئىككى قولى ئارقىلىق دۆلەت ۋە مىللەت  تەرەققىياتىنىڭ سەلتەنەتلىك تارىخىنى يازدى، خۇڭخۇا زېمىنىدا جاھاننى زىلزىلگە سالىدىغان ئۇلۇغ ئۆزگىرىشلەر بارلىققا كەلدى.
جوڭشەن ئەپەندىنىڭ ئارزۇسى بويىچە ئۇنىڭ قەبرىسى 1929-يىلى  نەنجىڭدىكى جوڭشەنگە كۆچۈرۈلگەن.
ئىسلاھات   سالمىقى، تەرەققىيات سۈرئىتى ۋە جەمئىيەتنىڭ بەرداشلىق بېرىش دەرىجىسىنى بىرلەشتۈرۈشتە چىڭ تۇرۇپ،       خەلق تۇرمۇشىنى ياخشىلاشنى ئىسلاھات بىلەن تەرەققىياتنىڭ مۇناسىۋىتىنى توغرا بىرتەرەپ قىلىشتىكى تايانچ نۇقتىسى  قىلىش كېرەك.
ئىسرائىلىيە ئىلگىرى كۆپ قېتىم قۇرۇلۇش ئىجازەتنامىسى كەم  ، ھەربىي ئىشلار سەۋەبتىن دېگەنلەرنى   باھانە قىلىپ پەلەستىنلىكلەرنىڭ ئۆيلىرىنى چاققان ياكى پەلەستىنلىكلەرنى قوغلىغان.
بۇ  يەر زور مىقداردا نەشە ۋە ئەپيون ئىشلەپچىقىرىلغاندىن باشقا كوكائىننىڭ دېڭىزدا توشۇلىدىغان جايى.
جيا چىڭلىن مۇنداق دېدى: جۇڭگو بىلەن كامبودژا دوست خوشنا  شۇنداقلا ئومۇميۈزلۈك ھەمكارلىق ئورناتقان ھەمراھلار.ئىككى تەرەپ سىياسى جەھەتتە.ئۆز-ئارا ئىشىنىدۇ، ئىقتىسادى جەھەتتە  ھەمكارلىشىپ، خەلقئارا سەھنىدە  بىر –بىرىنى قوللاپ، يېقىندىن ماسلىشىدۇ.
ئۈچىنچىدىن، ئامېرىكا خەلقى ھەربىي ئەۋزەللىك، ھەربىي تەۋەككۇلچىلىككە قارشى تۇردى،  شۇڭا ئۇ  خەلق رايىغا بويسۇنمىسا بولمايدۇ.
ھازىر يەنچى ناھىيەسىنىڭ نامراتلارنى يۆلەش ئاز سوممىلىق قەرز پۇلىنىڭ قالدۇق سوممىسى ئۈچ مىليارد 120 مىليون يۈەنگە يىتىپ، 28 مىڭ دېھقان   نەپكە ئېرىشتى،بۇلارنىڭ ئىچىدە ئارخىپ تۇرغۇزۇپ كارتا بېجىرگەن نامراتلار  قەرز سوممىسىنىڭ قالدۇق سوممىسى 540 مىليون يۈەنگە يىتىپ،  ھەر ئائىلىگە 66 مىڭ يۈەن توغرا كېلىپ قەرز سوممىسى پۈتۈن مەملىكەت بويىچە ھەممىدىن يۇقىرى بولدى.
شۇ كۈنى  جۇڭگو  - مالايسىيە  ئىككى تەرەپ  « جۇڭگو بىلەن ھىندونېزىيىنىڭ  ئومومىيۈزلۈك ستراتىگىيىلىك  ھەمراھلىق مۇناسىۋىتىنىڭ كەلگۈسى پىلانى  » نى ئېلان قىلدى .
29-سېنتەبىر ئۇ مامموسلېك شەھىرى سىرتىدىكى چاتقاللىقتا فېدېراتسىيە ئاۋىئاتسىيە ئىدارىسىنىڭ سالاھىيەت كارتىسى، ئايرۇپىلان ھەيدەش پىراۋىسى، كىملىك ۋە 1005 دوللار نەق پۇلنى   بايقاپ قالغان.
«يازدا تېمپىراتۇرا يۇقىرى بولغاچقا، ئاپتوموبىل كۈن نۇرىدا قىزىپ كەتسە ئاسانلا پارتلاش يۈز بېرىدۇ.»
يېڭى ئېنىرگىيەلىك ئاپتومۇبىلنىڭ ماتور سىستېمىسىنىڭ لايىھلىنىش ۋە ياسىلىش پەرقى تېخىمۇ  چوڭ ئىدى،     سەي ۋېي ئۇششاق زاپچاسلارنى    ئىشلەپچىقىرىشنىڭ  ئىنتايىن قىيىن ئىش ئىكەنلىكىنى   ئويلىدى.
مۇشۇ ئاينىڭ 24-كۈنى، ئىران يادرو مەسىلىسىدە ئومۇمىيۈزلۈك ھەل قىلىش لايىھىسى تۈزۈشتىكى ئاخىرقى قەرەل بولۇپ، ئىران يادرو مەسىلىسى سۆھبىتى ھالقىلىق باسقۇچقا كىردى.
بوشلۇقنى پىلانلاشنى ئېلىپ ئېيتساق، خەينەن ئۆلكىسىدە « كۆپ خىل بەلگىلىمىنى بىرلەشتۈرۈش» ئىسلاھاتىدىن بۇرۇن 1587 كۇۋادىرات كىلومېترلىق زېمىندا تەۋەلىك توقۇنۇشى مەۋجۇت بولۇپ، 701 مىڭ پارچە يەرنى باشقۇرۇش پىلانلاشتا تالاش-تارتىش كۆرۈلدى.
شۇ سەۋەبتىن دېجۇ شەھىرى شەندۇڭ ئۆلكىسىدىكى بۇلغۇنىش دەرىجىسى ئەڭ ئېغىر ، داۋاملىشىش ۋاقتى ئەڭ ئۇزۇن ، تاقابىل تۇرۇش تەدبىرلىرى ئەڭ ئاجىز شەھەر بولۇپ قالغان .
مۇشۇ بىر نەچچە يىلدا كېلىمات ئۆزگىرىشىنىڭ تەسىرىدە قۇتۇپ بىلەن ئوتتۇرا كەڭلىك گىرادۇسلۇق رايوننىڭ  تېمپىراتورا پەرقى كىچىكلىگەنلىكتىن، قۇتۇپ قاينىمى ئوتتۇرا كەڭلىك گىرادۇسلۇق رايونغا يۈزلىنىپ، مۇشۇ رايونلاردا قەھرىتان سوغۇق ۋە شىۋىرغاننى كەلتۈرۈپ چىقىرىش مۇمكىنچىلىكىنى ئاشۇرىۋەتتى.
قىسىمنىڭ ئەدەبىيات-سەنئەت تەنتەربىيە، ئاخبارات-نەشىرىيات خىزمەتچىلىرى سوتسىيالىستىك يادرولۇق قىممەت قارىشىنى ئەدەبىيات-سەنئەت تەشۋىقاتى ئىجادىيىتىدە، كۈندىلىك ھەركىتىدە ئاڭلىق، تەشەببۇسكارلىق بىلەن ئەكس ئەتتۈرۈپ، دەۋر ئاتا قىلغان تارىخ بۇرچىنى تىرىشىپ ئۈستىگە ئالدى.
بۇ قېتىملىق سىناق ئۇچۇرۇشتا بىر قاتار نەتىجىلەر قولغا كېلىپ، لياۋنىڭ ناملىق ئاۋىئاماتكىنىڭ سىناق مەشىقىنى تېخىمۇ چوڭقۇر ، تېخىمۇ كەڭ دائىرىدە ئىلگىرى سۈرۈشىگە پۇختا ئاساس سېلىندى.
بۇ جۇڭگو چوڭ قورۇقلۇقى ئالىمىنىڭ تۇنجى قېتىم  نوبىل تەبىئىي پەن مۇكاپاتىغا ئېرىشىشى ھەمدە  يۇقىرى باھاغا مۇيەسسەر بولۇشى، ئەمما تۇ يۇيۇ بۇ توغرىسىدا ھېچقانداق خەۋەرگە ئېرىشمىگەن ئىدى.
دۆلەت رەئىسى شى جىنپىڭ 7- ئاپرىل خەينەن ئۆلكىسىنىڭ بوئاۋدا ئالجىرىيە مىللىي پارلامنتىنىڭ باشلىقى بېنسالاھ بىلەن كۆرۈشتى .
55 ياشلىق كاپىتان رىچارد فىلىپس پاراخوت خادىملىرىنى قوغداش ئۈچۈن كۆكرەك كېرىپ ئوتتۇرىغا چىقىپ، دېڭىز قاراقچىلىرىغا  پاراخوت خادىملىرىنى تۇتماي، ئۆزىنى تۇتقۇن قىلىشىنى تەلەپ قىلىدۇ.
دەرەخلەر كېسىپ بولۇنغان يانباغىردا، كېسىلگەن دەرەخلەرنىڭ كۆتەكلىرى بار بولۇپ، كۆتەكلەر شۇ جاينىڭ يامغۇرلۇق ھاۋا رايى شارائىتىدا چىرىپ كەتمىگەن.ئۇنىڭغا قارىسىلا يېقىندا كېسىلگەنلىكىنى بىلىۋالغىلى بولىدۇ.
قىچىپ مەغلۇپ بولغان فىلىپىسنىڭ ئەھۋالى تېخىمۇ خەتەر ئىچىدە قالغان ، ئۇنى تۇتىۋالغان سومالى دېڭىز قاراقچىلىرى 2 مىليۇن ئامېرىكا دوللىرى تەلەپ قىلغان ھەمدە ئامېرىكا دېڭىز پاراخوتىدىن   سومالىدىكى ئوۋىسىغا قايتىپ بېرىۋېلىشىغا قولايلىق يارىتىپ بېرىشنى تەلەپ قىلغان .
مەركىزىي كومىتېت ، گوۋۇيۈەن «تېرىلغۇ يەرلەرنى قوغداشنى كۈچەيتىش ۋە ئىشلىتىش، تولۇقلىما بېرىش تەڭپۇڭلۇقىنى ياخشىلاش توغرىسىدىكى پىكىر»نى تارقاتتى.
پارتىيە ئىچىدە رىغبەتلەندۈرۈش ، كۆڭۈل بۆلۈش ، ياردەم بېرىش مېخانىزىمىنى مۇكەممەللەشتۈرۈپ ، ئىدىيە ، خىزمەت ، تۇرمۇش جەھەتتە ئاساسى قاتلام پارتىيە ئەزالىرىنىڭ بولۇپمۇ پىشقەدەم پارتىيە ئەزالىرى ، تۇرمۇشتا قىيىنىچىلىقى بار پارتىيە ئەزالىرىغا كۆڭۈل بۆلۈش، ياردەم بېرىشنى كۈچەيتىش ، ئۇلارغا تەشكىلنىڭ ئىللىقلىقىنى ھەقىقى ھېس قىلدۇرۇش كېرەك .
دۆلەتنىڭ «قوش يارىتىش»ئىستىراتىگىيەسى  داۋامىدا،  ياش تەتىقاتچىلار كوللېكتىپىنىڭ ئىگىلىك تىكلىشى ئۈچۈن نۇرغۇن سۇپا ھازىرلاپ بەردى، ياش تەتقىقات خادىملىرى يىڭىلىق يارىتىشتىكى ئاساسلىق سۇبېكىتقا ئايلاندى.
ئۇ كارخانىنىڭ تەتقىقات سالمىقىنى يەنىمۇ زورايتىپ، تەننەرق ۋە سەرپىياتنى يەنىمۇ تۆۋەنلىتىشىنى ئۈمۈد قىلدى.
« يەرلىككە قارىتا ھېچقانداق قانۇن ئىجرا قىلىش ھوقۇقىمىز بولمايدۇ، نۇرغۇن ئىشلارغا بىزنىڭمۇ ئامالىمىز يوق، پەقەت ئالاقە قىلىپ ماسلاشتۇرۇپ، نورمال تەرتىپ بويىچە ئېلىپ بارىمىز.»
شى جىنپىڭ تەبرىك تېلېگراممىسىدا مۇنۇلارنى كۆرسەتتى: 60 يىل مابەينىدە ئىككى دۆلەت خەلقى بوران-چاپقۇنلاردا بىللە بولۇپ، ئۆز ئارا يار-يۆلەك بولۇپ، بىر-بىرىنىڭ يادرولۇق مەنپەئەتىگە مۇناسىۋەتلىك مەسىلىلەردە ئىزچىل ئۆز ئارا قوللاپ، دوستلۇق مۇناسىۋىتىنى قويۇقلاشتۇرۇپ كەلدى.
يىغىندا ، مەملىكەتلىك خەلق قۇرۇلتىيى رېۋىزىيە ۋە ئەدلىيە كومىتېتى، مالىيە ئىقتىساد كومىتېتى، تاشقى ئىشلار كومىتېتى، يېزا ئىگىلىكى ۋە يېزا كومىتېتى ئايرىم-ئايرىم ئوتتۇرىغا قويغان 13-نۆۋەتلىك مەملىكەتلىك خەلق قۇرۇلتىيى 1-قېتىملىق يىغىنىنىڭ ھەيئەت رىياسىتى قاراپ چىقىشقا سۇنغان، ۋەكىللەر ئوتتۇرىغا قويغان لايىھەنى قاراپ چىقىش نەتىجىسى توغرىسىدىكى دوكلات ئاۋازغا قويۇپ ماقۇللاندى.
كىلمات ئۆزگۈرۈشكە تاقابىل تۇرۇش بىر تۈرلۈك سىستېمىلىق قۇرۇلۇش، پارنىك گازى قويۇپ بېرىلىشنى تىزگىنلەش   ئىقتىسادى، ئىجتىمائىي تەرەققىياتنىڭ كۆپ تەرىپىگە چېتىلىدۇ، ئىقتىسادىي ئىجتىمائىي تەرەققىيات   ئومۇمىيلىقىنى چىقىش قىلىپ، بىرتۇتاش ئويلىنىشقا توغرا كېلىدۇ.
سۆھبەتتىن كېيىن ، ئىككى دۆلەت زۇڭلىلىرى    ئىككى تەرەپ ھەمكارلىق ھۆججەتلىرىنى  ئىمزالاشقا شاھىد بولدى .
23-چىسىلا مۇخبىرلارنى كۈتىۋېلىش يىغىنىدا ، مۇخبىرلار سىلەرنىڭ  ئىتالىيە زۇڭلىسى بېرلوسكونىنىڭ سىياسى جەھەتتىكى ئىستىقبالىغا  ئىشەنچىڭلار بارمۇ دەپ سۇئال  سورىغاندا ، ئىككىسى خۇددى كېلىشىۋالغاندەكلا كۈلۈپ قويۇشتى .
روسىيە دېپلوماتىيە مىنسىتىرى لاۋروف 16-مارت: ئىلگىرى جاسۇس سىكېلپارنى  «زەھەرلەش»ۋەقەسىنى ئەنگلىيە كۆڭۈل قويۇپ پىلانلىغان، بۇ ئەنگليەنىڭ روسىيەگە قارشى ئەڭ يېڭى ھەرىكىتى، دېدى.
يەر شارى مۇھىت تەتقىقات ئورنىنىڭ كۆزلىمىسىگە ئاساسلانغاندا ، 2020- يىلغىچە ، بىر بەلباغ بىر يول لېنىيىسىدىكى ئاساسلىق 65 دۆلەتنىڭ يېڭى ئېنىرگىيە مەنبەسى يىللىق توك تارقىتىش مىقتارى بىر تىرىليون 400 مىليارت ۋاتقا يىتىدىكەن ، بۇ 14 سەنشيا ئىلىكتىر ئىستانسىسىنىڭ بىر يىللىق توك تارقىتىش مىقتارىغا تەڭ .
5 يىلدىن بۇيان جۇڭگونىڭ مەدەنىيەت تۈزۈلمە ئىسلاھاتى چوڭقۇرلاشتى، مەدەنىيەت كەسپى كۈنسايىن راۋاجلىنىپ، خەلق ئىگىلىكىنىڭ يېڭى ھەركەتلەندۈرگۈچ كۈچىگە ئايلاندى.
تۇتانكامۇننىڭ قەبرىسى 1922-يىلى ئەنگىلىيە ئارخىئولوگلىرى تەرىپىدىن تېپىلغان ، تېپىلغان ۋاقىتتا قەبرە بۇزۇلمىغان ۋە ئوغرىلانمىغان ، ھەمدەپنە بۇيۇملىرىمۇ مۇكەممەل ساقلانغان بولۇپ،   داڭلىق تۇتانكامون ئالتۇن يۈز نىقابىمۇ بىللە  تېپىلغان،
2013-يىلدىن ھازىرغىچە ، مەركىزى كومىتېت تەشۋىقات بۆلۈمى ، مائارىپ مىنىستىرلىكى 24 ئۆلكە ، شەھەرلىك پارتكوم  تەشۋىقات بۆلۈملىرى ۋە خەلق گېزىتى ، شىنخۇا ئاگېنتلىقى ، نۇر گېزىتى قاتارلىق مەركەز تاراتقۇلىرى بىلەن ئالى مەكتەپلەر بىرلىكتە ئاخبارات ئىنىستىتوتى قۇرىدىغانلىقىنى بېكىتتى.
روسىيە كۆچمەنلەر ئىدارىسى جامائەت ئىشلىرى كومىتېتىنىڭ رەئىسى ۋولوخنىڭ ئېيتىشىچە ، چەتئەل پۇقرالىرى روسىيەگە سىياسى پاناھلىنىش ئىلتىماسى سۇنۇپ بەش كۈن ئىچىدە، كۆچمەنلەر ئىدارىسىنىڭ خىزمەتچىلىرى ئىلتىماس قىلغۇچىنىڭ ئەھۋالىنى تەكشۈرىدىكەن، سىياسى پاناھلىنىش شەرتىگە ئۇيغۇن كەلمىسە، ئىلتىماسى دەرھال رەت قىلىنىدىكەن .
بۇ يىل 1-ئايدىن 9-ئايغىچە، بۇ كىچىك تاغلىق كەنت 2مىليون 150مىڭ ئادەم قېتىم ساياھەتچى كۈتۈۋېلىپ، ساياھەت كىرىمى 500مىليون يۈەنگە يەتتى.
ئېلىمىز ئۆز ئالدىغا لايىھىلەپ ياسىغان دۇنيادىكى ئەڭ چوڭ سفېرا رادىئو تېلېسكوپى FAST  نىڭ ئاخىرقى بىر تۈرلۈك ھالقىلىق قۇرۇلۇشى- قايتقان سىگنالنى قوبۇل قىلىش سىستېمىسى ئوڭۇشلۇق قۇراشتۇرۇلدى.
شۇڭا شۇ جايدىكى ھۆكۈمەت ۋاستىچى بولۇپ،    ياڭيۇ تېرىش ئارقىلىق كاڭباۋدىكى نامرات ئائىلىلەرنىڭ نامراتلىقتىن قۇرۇلۇشىغا ياردەم بېرىشنى قارار قىلدى.
ئارقىدىن پاكىستان دىپلوماتىيە مىنىستىرى كۈرەش   ئاخبارات ئېلان قىلىش يىغىنىدا:   : مەن بۇ خەۋەرنى راست دەپ قارايمەن ، بىراق پاكىستاننىڭ ئالاقىدار خادىملىرى ۋەقە يۈز بەرگەن رايوندىن ئىسپات ئېلىشى كېرەك،-دېدى .
2-ئاپرېل لوندۇندا ئۆتكۈزۈلىدىغان 20 دۆلەت گورۇھى پۇل مۇئامىلە باشلىقلار يىغىنىدا ئەزا دۆلەتلەر IMFنى ئىسلاھ قىلىش مەسىلىسىنى نۇقتىلىق مۇزاكىرە قىلىدۇ.
بىراق بۇنىڭغا ئەگىشىپ بىر قاتار مەسىلىلەرمۇ پەيدا بولدى، ئويۇن قائىدىسىگە يەنىلا ئامېرىكا ئۆزى يېتەكچىلىك قىلدى، بەزى نەرسىلەرنى باشقا چوڭ دۆلەتلەر ئۈستىگە ئېلىشنى ئويلاشسىمۇ، ئەپسۇس ئامېرىكىنىڭ ئۇلارنى ئۈستىگە ئالغۇزۇشى ناتايىن، لېكىن ئامېرىكا ئۈستىگە ئالسىكەن دېگەننى بولسا، باشقىلار ئۈستىگە ئېلىشنى خالىماسلىقى مۇمكىن.
ئاۋۋال تىنچلىق 1-ناملىق سۇ ئاستى كېمىسى چۆككەن ، ئۇنىڭغا بۇ قېتىمقى شىمالىي قۇتۇپنى ئىلمىي تەكشۈرۈش ئەترىتىنىڭ باشلىقى چىلىنگاروف بىلەن ئىككى ئىلمىي تەكشۈرۈش خادىمى چۈشتى .
ھوللىۋود ۋەكىللىكىدىكى  سودا كىنو چەمبىرىكىنىڭ سىرتىدا مۇستەققىل تۇرىدىغان ساينت دېنس كىنو كۆرۈكى ھازىر پۈتۈن دۇنيادىكى كۆلىمى ئەڭ چوڭ ،تەسىرى ئەڭ كەڭ مۇستەقىل كىنو ئىشلىگۈچىلەرنىڭ مەرىكىسىگە ئايلاندى.
خەلق گېزىتىنىڭ ئەتىكى سانىدا، «قانۇن ئىدارە قىلىش تەپەككۈرى ۋە ئۇسۇلى ئارقىلىق چىرىكلىشىشكە قارشى تۇرايلى» ماۋزۇلۇق ئوبزورچى ماقالىسى ئېلان قىلىنىدۇ.
بۈگۈن چۈشكە قەدەر «موراندى» ناملىق تەيفېڭ بورىنى سەۋەبىدىن فۇجىيەن ئۆلكىسىدىكى  ئۈچ مىليون 200مىڭ ئائىلىنىڭ توكى توختاپ قالدى.
سېررالېئوننىڭ دىپلوماتىيە مىنىستىرى كامارا، جۇڭگونىڭ سېررالېئوندا بارغانسېرى ئېغىرلىشىپ كېتىۋاتقان ئېبولا يۇقۇم ئەھۋالىغا ۋاقتىدا ئۈنۈملۈك ياردەم بەرگەنلىكىگە رەھمەت ئېيتتى.
مۇشۇ كۈنلەردە دېھقانلار ئېتىزدىكى پاتقاتنى تازىلاپ، شال قاتارلىق ئاشلىق زىرائەتلىرىنى تولۇقلاپ تېرىدى.
مۇسابىقىگە قائىدىسىگە ئاساسەن بۇ 30 ماھىر ئالتە كىچىك گۇرۇپپىغا ئايرىلىدۇ، ھەربىر گۇرۇپپا جەزمەن 48سائەت ئىچىدە فىلىمنى پىلانلاپ، سىنارىيىسى، سۈرەتكە ئېلىنىشىنى تاماملاپ، ئۈچ مىنۇتلۇق قىسقا فىلىم ئىشلەيدۇ، مۇسابىقىدە غەلىبە قىلغانلارنىڭ قىسقا فىلىمى MTV قانىلىدا پۈتۈن دۇنياغا تارقىتىلىدۇ.
بېيجىڭ جەنۇبىي ۋوگزالى  بېيجىڭ -شاڭخەي يۇقىرى سۈرئەتلىك تۆمۈر يولىدىن شەرقىي -جەنۇب يۆنىلىشىگە قاراپ  ماڭغاندا يېرىم سائەتتىلا  تېيەنجىنگە بارغىلى بولىدۇ.
لېكىن خاتىرە راۋىقىغا 130مىليۇن يۈەن خەجلىۋەتكەن ، بۇ كىشىلەر ئارىسىدا بەس مۇنازىرە قوزغىدى .
1.ئەنگىلىيەدىكى ھاكىمىيەت يۈرگۈزىۋاتقان كونسېرۋاتىپلار پارتىيەسىدىكى ئىككى ئايال پارلامىنت ئەزاسى يەنى ئىچكى ئىشلار ۋەزىرى تىرىسا ماي ۋە ئېنىرگىيە- كىلىمات ئۆزگىرىشى مىنىستىرلىقىدىكى ئېنىرگىيە ئىشلىرىغا مەسئۇل دۆلەت ئىشلىرى ۋەزىرى ئاندىرىيا رىدسوم تۈنۈگۈن ئۆتكۈزۈلگەن 2-نۆۋەتلىك پارتىيە ئىچىدىكى پارلامىنت ئەزالىرىغا ئاۋاز بېرىشتە غەلبە قىلدى.
دۆلەت شەھەر –يېزا ئاساسى قاتلاملىرىدا، ئوتتۇرا كىچىك كارخانىلار ۋە دۆلەت ئىلكىدە بولمىغان كارخانىلار، پەن-تەتقىقات تۈرلىرى ۋە مۇستەقىل ئىگىلىك تىكلەشتىن ئىبارەت تۆت يول ئارقىلىق ئىشقا ئورۇنلىشىشقا يېتەكچىلىك قىلىش، ئىشقا ئورۇنلىشىش- پىراكتىكا قىلىش ۋە ئىشقا ئورۇنلىشىشقا ياردەم بېرىشنى كۈچەيتىپ،  ئالى مەكتەپلەرنى پۈتتۈرگەنلەرنىڭ ئىشقا ئورۇنلىشىش مەسلىسىنى ھەل قىلىدۇ.
ناھىيە بازىرى ئېغىر ئاپەتكە ئۇچراپلا قالماستىن،     يېقىن ئەتراپتىكى يېزا-بازارلارمۇ كەلكۈندىن ئامان قالمىدى، شادا كەنتى يۇڭجى ناھىيەسىگە بىر كىلومېتىر     كېلىدىغان بولۇپ، بۇ قېتىملىق كەلكۈن ئاپىتىدە ئاپەتكە ئەڭ ئېغىر ئۇچرىغان كەنت ، پۈتۈن كەنتتىكى 500دىن ئارتۇق تۇرالغۇ ئۆي ئىچىدە 400دىن كۆپىرەكى ئېغىر زىيانغا ئۇچرىدى.
بۇ يېقىندا مەركەز كۆزىتىش گۇرۇپپىسى بارلىق كۆزىتىش قايتما ئىنكاس ۋەزىپىسىنى تاماملىغاندىن كېيىن مەسىلە يىپ ئۇچىنى مەركىزىي ئىنتىزام تەكشۈرۈش كومىتېتىغا تاپشۇرۇش نەق مەيدانى.
30-ئىيۇنغىچە ٪90ۋىلايەت شەھەر، ٪50ناھىيەلىك پارتكوم بەنزىسى مەخسۇس تېمىلىق دېموكىراتىك تۇرمۇش يىغىنى ئاچقان.
ئېلىمىزنىڭ ئىنتېرنېتنى ئومۇملاشتۇرۇش نىسبىتى %51.7گە يېتىپ ، دۇنيانىڭ ئوتتۇرىچە سەۋىيەسىدىن %3.1ئېشىپ كەتكەن .
3 مىليون يۇەنلىك باج كېمەيتىلگەندىن كىيىن ، كۆچمە مەبلىغىمىز ئاشقانغا باراۋەر بولدى، بىز خام ماتېرىيال سېتىۋىلىش، تېجارەت يوللىرىنى قوغداش، يەنە قىسمەن تەتقىق قىلىپ ئېچىشكە مەبلەغ سالالايمىز.
يېڭى ئومبېرى  تەنتەربىيە مەيدانى 90 مىڭ تاماشىبىننى سىغدۇرالايدۇ ، كەتكەن راسخوت 750 مىليون فونسترلىڭدىن ئاشىدۇ .
ساقچىلار: بۇ زەھەرلەرنىڭ كېلىش مەنبەسى ئېنىق ئەمەس،  تەھلىل قىلىشىمىزچە،  شەرقىي جەنۇبىي ئاسىيا رايونىدىن كەلتۈرۈلگەن بولۇشى مۇمكىن دېدى.
باۋارىيە ئىشتاتىدا يېڭىدىن بارلىققا كەلگەن تاماكا چەكلەش بۇيرۇقىنىڭ تەسىرىدە، بۇ يىللىق ميۇنخىن پېۋا بايرىمىمۇ تۇنجى نۆۋەتلىك ئىس تۈتەكسىز پېۋا بايرىمى بولۇپ قالدى.
ئەگەر مۇسسىكاپا قۇشىنى باشقا يەرگە ئېلىپ كەتسە بۇ يەرگە كىلىدىغان ساياھەتچىلەر نىڭ يېرىمى ئازلاپ كىتىدۇ،بىلىشىمىز كىرەككى بۇ كىشىلەر مۇسسىكاپا قۇشىنى كۆرۈش ئۈچۈن بۇ يەرگە كىلىدۇ.
بىر بىرىدىن ئايرىلماسلىق ، بىر-بىرىگە تايىنىپ ياشاش ،ئادەتتىكى ئائىلىلەر ئۈچۈن ئۆمۈرلۈك بەخت ھېسابلىنىدۇ .
جۇڭگو ساھىپخان دۆلەت بولۇش سۈپىتى بىلەن ئاخىرىقى باشلىقلار يىغىنىدا دۇنيا ئىقتىسادى دۇچ كەلگەن نۇرغۇن مەسىلىلەرگە تەرەپلەرنى ئەڭ زور چەكتە ئىنكاس قايتۇرۇش ، ئەڭ كۆپ ئورتاق تۇنۇش ھاسىل قىلىش ئىمكانىيىتىگە ئىگە قىلىپ، ئاخىرىدا بىرىكمە كۈچ شەكىللەندۈرىدۇ.
« ئومۇمىي ئىقتىساد ئەھۋالىدىن قارىغاندا، كېسەك ئالتۇن دۆلەتلىرىنىڭ   دۇنيا ئىقتىسادىنىڭ ئېشىشى،  مۇقىم ئىلگىرى سۈرۈلىشىدە ئەھمىيىتى ناھايىتى زور، كېسەك ئالتۇن دۆلەتلىرىنىڭ بولۇپمۇ جۇڭگونىڭ دۇنيانىڭ  ئىقتىسادى مۇقىملىقى ۋە  رەھبەرلىك كۈچىنىڭ   مەنبەسى بولۇپ قېلىشىنى ئۈمىد قىلىمىز»
ئىككى ھەپتىدە بىر قېتىم ئۆتۈلىدىغان ئەنئەنىۋى مەدەنىيەت دەرىسسلىكى يېرىم يىل ئۆتۈلۈپلا شۇ جاينىڭ قىياپىتى ، ئاممىنىڭ قىياپىتىدە كۆرۈنەرلىك ئۆزگۈرۈش بولدى .
ليۇ يۈنشەن مۇنداق دېدى:  مەدەنىيەت  ئىشەنچىمىزنى چىڭىتىشىمىزدا يېتەرلىك ئاساسىمىز بار، مۇھىمى ئۆزگىچە مەدەنىيەت ئەۋزەللىكىمىزنى بىلىشىمىز كېرەك.
تور ئەھلى ، ۋۇ خەي ئۇچۇق خېتىدە ئۆزلىرى دېيىشكە پېتىنالمىغان سۆزلەرنى ئېيتتى ، دەپ باھا بەردى ھەتتا ۋۇ خەينى قەھرىمان دەپ ماختىدى .
ئارتىسلارنىڭ نەپىس كىيىملىرى ۋە مۇڭلۇق مۇزىكىلىرى تاماشىبىنلارغا ھوزۇر بېغىشلىدى.
20-يانۋار ياۋرۇپادىكى نۇرغۇن دۆلەتلەردە قېلىن قار ياغدى، كەڭ كۆلەمدە ياغقان قار قاتناشقا ئېغىر تەسىر كۆرسەتتى.
2016- يىلى 10- ئايدا، ئاپتونوم رايونىمىز «مىللەتلەر ئىتتىپاقلىشىپ بىر ئائىلە كىشىلىرىدەك بولۇش» ۋە مىللەتلەر ئىتتىپاقلىقى بىرلەشمە دوستلۇق پائالىيىتىنى قانات يايدۇردى.
بىز نۇرغۇن تەنھەركەت  تۈرلىرىنىڭ مۇز ۋە قار ئۈستىدە ئۆتكۈزۈلىدىغانلىقىنى بىلىمىز.
ھايۋانات باغچىسى خىزمەتچىسى:    ھازىر مالى يېڭى كەلگەن چاغدىكىدەك   ئاجىز ئەمەس ، بەدەن كۈچى بارغانسىرى ياخشىلىنۋاتىدۇ ، كۆزلىرىدىنمۇ  نۇر چاقناپ تۇرىدۇ دىدى .
يېقىنقى كۈنلەردە، ئىچكى مۇڭغۇل، خېيلۇڭجياڭ، گەنسۇ قاتارلىق جايلاردىكى يىمەكلىك، دورا بىخەتەرلىكىنى نازارەت قىلىش ئىدارىسىنىڭ خادىملىرى ئۆز قارىمىقىدىكى بۇۋاقلار رىتسىپلىق سۈت پاراشۇكى ئىشلەپچىقىرىدىغان كارخانىلارنى تەكشۈرۈشنى باشلىدى.
ھۆكۈمەتنىڭ يېتەكلىشى، كەنت كادىرلىرىنىڭ باشلامچىلىق قىلىشى، پۇقرالارنىڭ قاتنىشىشى بىلەن خۇئەن كەنتىنىڭ مۇھىتى ياخشىلاندى، مۇھىتنىڭ ياخشىلىنىشى بىلەن خۇئەن كەنتى يېڭى تەرەققىيات يولىنى تاپتى، كەنتتە 70نەچچە سەھرا ئارامگاھى قۇرۇلۇپ، يىراق-يېقىنغا مەشھۇر ساياھەت كەنتىگە ئايلاندى.
بىر تەرەپتە ئادەم قۇتقۇزماقچى بولغان دۇنيادىكى بىرىنچى ھەربىي ئىشلار دۆلىتى ، يەنە بىر تەرەپتە يۇقىرى سوممىلىق قايتۇرۋېلىش پۇلىنى كۈتۈپ تۇرغان سومالى دېڭىز قاراقچىلىرى تىركەشتى ، قاراڭغۇ چۈشكەندە بىر ياخشى پۇرسەت كەلدى ، يەنى تۇتقۇن قىلىنغان كاپىتان فىلىپىس دېڭىزغا سەكرەپ ئامېرىكا ئارمىيىسىنىڭ « بانبۇلىچ » ناملىق قوغلىغۇچى پاراخۇتىغا قاراپ ئۈزدى .
بۈگۈنكى كۈندە، جۇڭگو-بېلوروسىيە سانائەت رايونى جۇڭگونىڭ چەتئەلدىكى ئەڭ چوڭ سودا ھەمكارلىق رايونى شۇنداقلا ياۋروپادىكى ئەڭ چوڭ سانائەت رايونى بولۇپ قالدى.
ئىشتىن توختاش ھەقىقەتەن كىشىنىڭ بېشىنى ئاغرىتىدۇ، لېكىن ئۇنىڭ ئەسلىگە كېلىدىغانلىقىغا ئىشىنىمىز، كېيىن بۇنداق ئىشنىڭ يۈز بەرمەيدىغانلىقىغا ئىشىنىمەن.
ئالتۇن ھەپتىلدە بېلەت باھاسىدىن باشقا يەنە بىر ئىش دىققەتنى قوزغىدى، مۇخبىر لىجياڭدىن شياڭگىرىلاغا بارىدىغان ساياھەت ئۆمىكىگە قاتناشقاندا  ساياھەت كوپېراتىپى خىزمەتچىلىرى  ھەربىر ساياھەتچىدىن 280 يۈەندىن 380يۈەنگىچە پۇل  تاپشۇرۇپ، زاڭزۇلارنىڭ ئۆيلىرىنى زىيارەت قىلىدىغان  ساياھەت تۈرىگە قاتنىشىشنى تەلەپ قىلدى.
مەۋقەنى مەھسۇلاد سۈپىتىنى ئۆستۈرۈش ۋە يادرولۇق رىقابەت كۈچىنى ئاشۇرۇشتىن ئىبارەت ئاساس يۆنىلىشكە قارىتىپ ، يېڭىلىق يارىتىش ئارقىلىق تەرەققىياتقا تۈرتكە بولۇشنى چوڭقۇرلاشتۇرۇپ ،  تىپنى ئۆزگەرتىپ دەرىجىسىنى ئۆستۈرۈشنى ئىلگىرى سۈرۈش كېرەك .
فۇجيەن ئۆلكىسى مەبلەغ سېلىشنى زورايتىش ئارقىلىق، نۇقتىلىق تۈرلەرنى يۆلەپ، مېيىپلارغا ياردەم بېرىشتە ئۇزاققىچە ئۈنۈم بېرىدىغان مېخانىزىمنى شەكىللەندۈرۈپ، مېيىپلار ئىشلىرىنىڭ تەرەققىياتىنى تېزلەتتى.
«ئەرش ئوردىسى 1-» نىڭ 343كىلومېتىرلىق ئۇچۇش ئوربىتىسىغا ئوخشىمايدىغان يېرى، «ئەرش ئوردىسى 2-»نىڭ ئۇچۇش ئوربىتىسىنىڭ ئىگىزلىكى يۇقىرى بولۇپ،  بۇ ئارقىلىق بوشلۇق پونكىتى تېخنىكىسى  دەلىللىنىدۇ.
كۈزىتىش خىزمىتى شەھەر، ناھىيە، يېزىلارغىچە ئۇزارتىلىپ، نازارەتچىلىك ئومومىيۈزلۈك تولۇق قاپلىدى، بۇ پارتىيىنى ئومومىيۈزلۈك قاتتىق باشقۇرۇشتىكى ئەڭ ئاخىرقى بىر كىلومېتىر بوشلۇقنى تولدۇردى.
ۋەقەدىن كېيىن بەزىلەر يى يۆمىڭدىن  قانداق قىلىپ بۇنداق جاسارەتكە كەلگەنلىكىنى سورىغاندا، ئۇ شۇ چاغدا ھېچنىمىنى ئويلىمىغانلىقىنى، ئېيتتى.
يىغىنغا قاتنىششقا تېگىشلىك ئادەم 190، قاتناشقان ئادەم 190، قاتناشقان ئادەم سانى قانۇندا بىكىتلىگەن ئادەم سانىغا ئۇيغۇن.
ئېھتىياجنىڭ يېتەرلىك بولماسلىقى دۇنيا ئىقتىسادىنىڭ ئەسلىگە كېلىپ بولالماسلىقىدىكى ئاساسلىق ئامىل، ئېھتىياج يوشۇرۇن كۈچى چوڭ بولغان بازار دەل جۇڭگودا.
داۋالاش ئۆيىگە كىرگەندە سول   تەرىپىمىدىكىسى ئوپىراتسىيەخانا، بۇ يەردە تاشقى، ئىچكى كېسەللەر ئوپىراتىسيەسى قىلىنىدىكەن.
ئارقىدىن ، مۇخبىر باك ئىشلەپچىقىرىدىغان يەنە بىر يەرلىك كارخانا خېبېي چاڭخۇا مەخسۇس ئاپتوموبىل شىركىتىنى يوشۇرۇن زىيارەت قىلدى .
2015-يىلى خەينەن ئۆلكىسى ئىشنى پىلاننى ئىسلاھ قىلىشتىن باشلاپ ، مەملىكىمىتىمىز بويىچە ئەڭ ئاۋال « پىلانلارنى بىرلىككە كەلتۈرۈش» ئىسلاھاتىنى نۇقتىدا سىناق قىلدى، مەقسىدىنىڭ بىرى ئۆي-زېمىن كەسپىنىڭ زىيادە تەرەققىي قىلىش مەسىلىسىنى تېزگىنلەش ئىدى.
تەتقىقاتچىلار مۇنداق دىدى: بۇ سۆڭەك بوشىشىش كېسىلى ۋە بوغۇم ياللۇغى قاتارلىق ئاستا خاراكتېرلىق كېسەللىكلەردىن ساقلىنىشقا پايدىلىق.
ھىندونېزىيە مېتروئولوگىيە ۋە يەر شارى فىزىكىسى ئاپاراتى ئېلان قىلغان سانلىق مەلۇماتقا قارىغاندا ، شۇ يەر ۋاقتى بىلەن 12- سىنتەبىر كەچتە يەر تەۋرىگەندە ، تەۋرەش مەركىزى جەنۇبىي  كەڭلىك 4.67 گىرادۇس ، شەرقىي مېردىئان 101.13 گىرادۇستا  يەنى  سۇماترا ئارىلىغا جايلاشقان بېڭكۇلۇ ئۆلكىسىنىڭ غەربىي جەنۇبىيغا 159 كىلومېتىر كېلىدىغان دېڭىز تەۋەلىكىدە بولۇپ ،       تەۋرەش مەنبەسى دېڭىز يۈزىدىن 10 كىلومېتىر چوڭقۇرلۇقتا    ئىكەن  .
60مىڭ يۇەن ياكى 100مىڭ يۇەن بولسۇن، ئۆزۈمگە تېگىشلىك بولمىغان پۇلنى ئالمايمەن ، بۇ كىچىك ئىش، قىلىشقا تېگىشلىك دەپ ئويلايمەن .
ئىجتىمائى زىددىيەتلەرنى  ھەل قىلىش، جەمئىيەت باشقۇرۇشتا يېڭىلىق  يارىتىش ۋە ئادىل، پاك قانۇن ئىجرا قىلىشتەك ئۈچ مۇھىم خىزمەتنى ئىلگىرى سۈرۈپ، ئاممىنىڭ ھاياتى ۋە مال مۈلۈك بىخەتەرلىكىنى ، جەمئىيەتنىڭ ئادىل، ھەققانىيلىقىنى، جەمئىيەتنىڭ  مۇقىملىقىنى قوغداش كېرەك.
نۆۋەتتە خۇلىمبېر چارۋىچىلىق رايونىدا چارۋىلارنىڭ توڭلاپ قىلىشى، يوقاپ كىتىشىدەك ئەھۋاللارنىڭ ئالدىنى ئېلىش ئۈچۈن ، چارۋىلارنى قوتاندا بىقىش تەلەپ قىلىندى .
قورۇلمىلىق ئىسلاھاتنى زور كۈچ بىلەن ئىلگىرى سۈرۈشتە چىڭ تۇرۇپ، تەرەققىياتقا توسقۇنلۇق قىلىۋاتقان چوڭقۇر قاتلاملىق مەسىلىلەرنى نۇقتىلىق ھەل قىلىش كېرەك.
ئىلگىرى چاغان ئۆتكۈزسەك توخۇ، ئۆردەك دېگەنلەرنى چاغانغىچە ساقلاپ  ئاندىن   يەيتتۇق،  ھازىر بولسا چاغانلىق  كەيپىيات چىقىرىشقا بەكرەك ئەھمىيەت بېرىدىغان بولدۇق، بۇ كۈرەش قىلغانلىقىمىزنىڭ نەتىجىسى، ۋەتەن قۇرۇلۇشى ئەۋلادمۇ-ئەۋلاد ئۇتۇقلۇق داۋاملىشىدۇ.
سودا داۋامىدا مۇئامىلدار ئالقان ئىزىنى سىكانېرلاش ئارقىلىق ئۆز سالايىھىتىنى جەزىملەشتۈرىدۇ .
پاختا ، كاناپ  قاتارلىق يىنىك راھەت رەخلەر بىلەن كۆركەم راھەت ئەتىيازلىق ئۇسلوپ يارىتىلغان .
بۇ ماھىرلار تەربىيەلەنگەندىن كېيىن سەھنىگە چىقىپ ئۆزلىرى سۈرەتكە ئالماقچى بولغان سىنارىيەنىڭ مەزمۇنىنى سۆزلەيدۇ، قانداق ئۇسلۇبتىكى فىلىم مەنزىرىسىنى سۈرەتكە ئالىدىغانلىقىنى نامايەن قىلىدۇ، شۇنداقلا يەنە سەھنە ئاستىدىكى ئوقۇتقۇچىلارنىڭ سۇئاللىرىغا جاۋاپ بېرىدۇ.
«ئەلۋەتتە بازار رىقابىتىمۇ كەسكىنلىشىۋاتىدۇ، بىز داۋاملىق ئالدىغا قاراپ ئىلگىرلەيمىز، چۈنكى مەن ئىگىلىك تىكلەشكە ئامراق.»
كەنت ئاھالىلىرىنىڭ پىكرى ئاخىرى بىرلىككە كەلدى، توي-تۆكۈن، ئۆلۈم- يېتىم ، تۇغۇتتىن باشقا ھەرقانداق ئىشقا زىياپەت بەرمەيدىغان بولدى.
ئائىلە تەربىيەسى بالىلارنىڭ ئۆسۈپ-يېتىلىشىدە ناھايىتى مۇھىم ، ئاياللارنىڭ ئائىلىدىكى رولىغا سەل قاراشقا بولمايدۇ .
6-ئاينىڭ ئاخىرلىرىدا ، شەنشى ئۆلكىسى ۋېينەن رايۇنى پۇچىڭ ناھىيىسىدە تېمپىراتۇرا ئۇدا نەچچە كۈن 40 سىلسىيە گرادۇس ئەتراپىدا بولدى ، بۇنداق تومۇز ئىسسىقتا ، ناھىيەدىكى كەنتتە تۇرۇشلۇق نامراتلارنى يۆلەش كادىرى سۇفاڭ بازىرى داڭدىڭ كەنتىنىڭ شۇجىسى جېڭ جيې ، كوللىكتىپ قوتاندىكى 1400 دىن ئارتۇق سۈت ئۆچكىسىدىن ئەنسىرەپ قالدى .
شىۋىتسىيە جۇڭگونىڭ تەرەققىياتىدىن  كەلگەن پۇرسەتنى چىڭ تۇتۇپ، ئىككى تەرەپنىڭ مەبلەغ سېلىش، يېڭىلىق يارىتىش، مۇھىت قاتارلىق ساھەلەردىكى ئۆز-ئارا مەنپەئەت يەتكۈزىدىغان ھەمكارلىقىنى يەنىمۇ كېڭەيتىشنى ئۈمىد قىلىدۇ، ئەركىن، باراۋەر سودىنى داۋاملىق قوغداشنى خالايدۇ.
ھىندونىزىيىنىڭ تېرورلىققا قارشى ھەربىي ۋە ساقچىلىرى بۇ 4 جىنايەت گۇماندارىنى يالاپ ئايرۇپىلان بىلەن بالى ئارىلىغا ئېلىپ بېرىپ ، شەرقىي تېمور تەرەپكە رەسمىي ئۆتكۈزۈپ بەردى ، كېيىن ئۇلار شەرقىي تېمور پايتەختى دىللىغا ئېلىپ بېرىلدى .
ئىگىلىنىشىچە، جىنرۇڭ مەھەللىسىدە ئاھالىلەر بىر قەدەر كۆپ بولۇپ، سانجى شەھىرىدىكى كۆلىمى بىر قەدەر چوڭ مەھەللە ھىسابلىنىدۇ،شۇڭا، مەھەللىدە تۇرۇشلۇق خىزمەت ئەترىتى 12 پارتىيە ئەزاسى گۇرۇپپىسى قۇردى ھەمدە «مەھەللە كادىرلىرى، پارتىيە گۇرۇپپىسى مەسئۇلى، پارتىيە ئەزالىرى، بىنا باشلىقى، پىدائىيلار» دىن تەشكىللەنگەن ئاساسىي قاتلام مۇلازىمەت قوشۇنىنى قۇرۇپ چىقىپ، تەۋەلىكىدىكى ئاھالىلەرنى قولاي، ئۈنۈملۈك مۇلازىمەت بىلەن تەمىنلىدى.
سىز ئۆيدە تۇرۇپلا ھەر قايسى دۆلەتتىكى كۈتۈپخانىلاردا ساقلىنىۋاتقان قىممەتلىك ئەسەرلەر مەسىلەن جۇڭگونىڭ چىغىناق-تاغاق يېزىقى ۋە تاش ئابىدە ماتېرياللىرى، مىسىرنىڭ دەسلەپكى مەزگىلدىكى ئەرەپ پەننى ئوقۇشلۇقلىرى، برازىلىيىنىڭ لاتىن ئامېرىكىسىدىكى كونا رەسىملىرىنى كۆرەلەيسىز.
ھۆكۈمەت قارىمىقىدىكى ئوتتۇرا مەكتەپ بىلەن سېلىشتۇرغاندا، خۇسۇسى ئوتتۇرا مەكتەپلەرنىڭ ئوقۇتۇش سۈپىتى ۋە ئۈگىنىش كەيپىياتى يۇقىرى، بىراق ھەق ئېلىش ئۆلچىمىمۇ ئىنتايىن يۇقىرى.
ئەمما ئەلنەغمىنى ئۈگۈنۈش جاپالىق، كىرىم ئاز بولغاچقا تالانتى بار ئەمما ئۈگىنىشنى خالايدىغان ياشلارنى تاپماق قىيىن، ليو فەن ھازىر ئەينى چاغدا ئۇستازى ئۆزىنى شاگىرىتلىققا ئالغان چاغدىكى ئۇستازىنىڭ يېشىدىن  ئۆتۈپ كەتكەن بولسىمۇ لېكىن شاگىرت ئالالمىدى، ئۇ بۇنىڭدىن ئەپسوسلىنىدۇ، جياڭشى ئەلنەغمىسىگە ۋارسلىق قىلىش ھەرقايسى تەرەپنىڭ قوللىشىغا مۇھتاج  .
يېقىندا نوپۇس يۆتكەش ئۈچۈن 20 قېتىم قاترىدىم ،بىر قېتىم ج خ ئىدارىسىنىڭ نوپۇس ئىشلىرى بۆلىمى ئىسمىمنى خاتا بېسىپ قويدى ، بىر قېتىم نوپۇس تۇرۇشلۇق جاينى خاتا يېزىپ قويدى .
فوكوشىما يادرو ۋەقەسىدىن كىيىن فوكوشىمادىكى 1- يادرو ئېلېكتر ئىستانسىسى ئەتراپىدىكى رايونلار يادرو رىئاكسىيەسى سەۋىيەسىنىڭ يۇقۇرى تۆۋەنلىكىگە ئاساسەن «ئۆيگە قايتىش قىيىن رايون»، «تۇرۇش چەكلەنگەن رايون» ۋە «تارقاقلاشتۇرۇش كۆرسەتمىسىنى بىكار قىلىش تەييارلىق رايونى» دەپ ئايرىلغان.
بۇ يىل 4-ئاينىڭ 6-كۈنى 39ياشقا كىرگەن ئەخمەت ئىمىننىڭ  يۈرەك كېسىلى ئۇشتۇمتۇت قوزغۇلۇپ سوت مەيدانىدا بەختكە قارشى ۋاپات بولدى.
بۇنىڭ ئىچىدە بوستون، چېكاگو قاتارلىق شەھەرلەردە  يېڭى يىلنىڭ بىرىنچى كۈنىدىن باشلاپ قېلىن قار يىغىپ،  شىۋىرغان چىققان ، بوستوننىڭ قىسمەن رايونلىرىدا تۆنۈگۈن كەچتە ياغقان قارنىڭ قېلىنقى 60 سانتىمېتىرغا يەتكەن.
ئالتە يىل بۇرۇن بۇ جايدا جۇڭگودىكى پۈتكۈل شەرقىي قىسىم رايونىدىكىگە ئوخشاش،     ئادەم كۆپ يەر ئاز، بىر ئائىلە  ئارانلا ئۈچ، تۆت مو  يەرنى تېرالايدىغان بولۇپ، پەقەت قورساق توقلاشقىلا      يېتەتتى.
بۈگۈن ئۆتكۈزۈلگەن گوۋۇيۇەن سىياسەت  خەۋەرلەندۈرۈش يىغىنىدا مۇئاۋىن مالىيە مىنىستىرى       شى خۇيبىن ۋە دۆلەت   باج باش ئىدارىسىنىڭ باش مەسئۇل بوغالتىرى ۋاڭ لۇجېڭنىڭ تونۇشتۇرۇشىچە ، بۇ يىل 5-ئاينىڭ 1-كۈنىدىن باشلاپ ، يېڭىدىن نۇقتىدا سىناق قىلىنىش دائىرىسىگە كىرگۈزۈلگەن پۇل مۇئامىلە، بىناكارلىق قۇرۇلۇش ، ئۆي  زىمىن ۋە تۇرمۇش مۇلازىمىتىدىن ئىبارەت تۆت چوڭ كەسىپنىڭ 10-ئاينىڭ ئاخىرىغىچە  96 مىليارد 500 مىليون يۇەن بېجى كېمەيتىلدى .
بۇ خىل سۈپەتلىك ئۇننىڭ ھەر جىڭىنىڭ  باھاسى  15 يۈەن  بولۇپ، بازاردىكى ھەر جىڭى 2 يۈەندىن 3يۈەنگىچە بولغان  ئادەتتىكى ئۇننىڭ باھاسىدىن  نەچچە ھەسسە يۇقىرى.
خەنگۇڭنىڭ بىزگە ئېيتىپ بېرىشىچە، 740مىليون يۈەن مەبلەغ سېلىنىغان 816-نومۇرلۇق ئۆڭكۈرنىڭ ئومومى كۆلىمى 104مىڭ كىۋادرات مېتىر بولۇپ ، 15پۇتبول مەيدانىغا باراۋەر ئىكەن .
بۇ قېتىم ئۇ سياسى كېڭەشنىڭ ئەزاسى سۈپىتىدە ئوتتۇرىغا چىققاندىن كېيىن، نۇرغۇن كىشى ئۇنىڭ يەنە بىر سالايىھىتىگە يەنى، بېيجىڭ شەھىرى دوڭچىڭ رايونلۇق ئالاھىدە مائارىپ مەكتىپىنىڭ مۇدىرى ئىكەنلىكىگە دىققەت قىلدى.
ئىگىلىنىشىچە بۇ ئۆزگەرتىش پىلانى يەنە مۇنارنىڭ ئەتراپىدىكى يوللارنىمۇ ئۆز ئىچىگە ئالىدىغان بولۇپ، جەمئى20مىليون ياۋرۇ مەبلەغ سېلىنىدىكەن.
شەرق قىزاردى بىرىنچى ناملىق سۈنئىي ھەمراھ ئارقىلىق  جۇڭگونىڭ سۈنئىي ھەمراھ دەۋرىنى باشلاشتىن، ئاي پەرى ناملىق سۈنئىي ھەمراھ  ئالەمنىڭ ئىچكىرىسىنى تەكشۈرۈش قەدىمىنى تاشلاشقىچە، سۈن جيادوڭ نەچچە ئون يىل قېتىرقىنىپ ئىشلەپ، جۇڭگونىڭ ئالەم قاتنىشى غايىسىنى قاناتلاندۇردى.
تەكشۈرۈش ئارقىلىق ، غەربىي رايون گېزىتخانىسىنىڭ باشقۇرۇشى ئۇزۇن مەزگىل قالايمىقان بولغان، مۇخبىرلىك ، تەھرىرلىق بىلەن تىجارەت ئايرىۋېتىلمەي ، مۇخبىرلارغا تىجارەت خارەكتىرلىك ۋەزىپىلەر  تاپشۇرۇلغان ، ھازىر ئىش توختىتىپ تۈزەشكە بۇيرۇلدى .
2-ئاينىڭ 28-كۈنى سائەت 12 گىچە، دېڭىز تاشقىنى تىنچ ئوكياننىڭ شەرقى قىرغىقىغا يېتىپ بارغان، ياپونىيە قاتتىق مۇھاپىزەتتە تۇرغان.
تيەنجىن شەھىرى نۇقتىلىق تەرەققى قىلدۇرىدىغان سۈنئىي ئەقلىي ئىقتىدار، يېڭى دەۋر  ئۇچۇر تېخنىكىسى قاتارلىق گۈللەنمە كەسىپلەر ساھەسىدە، كارخانا جىددىي ئېھتىياجلىق بولغان يۇقىرى دەرىجىلىك ئىختىساسلىقلار   تىزىملىكنى چىقارسىلا تيەنجىن شەھىرى تىزىملىك بويىچە ھەممىسىنى قوبۇل قىلدى.
ئەنخۇي كادىرلارنى نازارەت قىلىش، كۆزىتىش مىخانىزىمىنى ئۈزلۈكسىز كۈچەيتىپ، كۆزىتىشنى تولۇق قاپلاپ، تۈزۈمنى چىڭىتتى.
تەشكىلىي جەھەتتىن تەكشۈرۈپ ئېنىقلاش ئارقىلىق سۇچەن شەھەرلىك پارتكوم جاڭ داۋگەننىڭ 1942-يىلىدىكى پارتىيە ئەزاسىلىق سالاھىيىتىنى ئەسلىگە كەلتۈرۈشنى قارار قىلدى .
بۇ ساتۇرن بورىنى مەركىزىنىڭ دىئامېتىرى 2 مىڭ كلومتردەك بولۇپ ، يەر شارىدىكى ئادەتتىكى بوران مەركىزىنىڭ 20 ھەسسىسىچىلىك  كېلىدۇ .
«ئاساسلىقى ئوڭ پۇتۇم، ئوڭ پۇتۇم سۇنغان ئوخشايدۇ، مىدىرلىتالمايۋاتىمەن، سول پۇتۇم جىرىلىپ كېتىپتۇ»
بۇ يىل 7- ئايدىمۇ مۇشۇنداق گۇمان پەيدا بولدى، ئىتالىيەنىڭ لاكۇيلادا 8 دۆلەت گۇروھىغا ئەزا دۆلەتلەر باشلىقلار يىغىنى ئۆتكۈزۈلگەندە ، يىغىننىڭ تەشكىللىنىشى قالايمىقان ، ئۇنىڭ ئۈستىگە ئىتالىيە ئەزالىق بەدەل پۇلىنى نىسى سۆرەپ كېلىۋاتقان ھەمدە ئافرىقىغا ياردەم بېرىش ۋەدىسىنى ئەمىلىلەشتۈرمىگەن بولغاچقا،  بەزى ئاخبارات ۋاستىلىرى ئىتالىيەنى 8 دۆلەت گۇروھىدىن ھەيدەپ چىقىرىپ،  ئۇنىڭ ئورنىغا ئىسپانىيەنى كىرگۈزۈش تەكلىۋىنى بەردى .
بۇ نۆۋەتلىك ئاسىيا تەنھەركەت مۇسابىقىسى 1990-يىلى بېيجىڭدا  11-نۆۋەتلىك ئاسىيا تەنھەركەت مۇسابىقىسى ئۆتكۈزۈلۈپ 20 يىلدىن كېيىن جۇڭگودا ئۆتكۈزۈلگەن يەنە بىر نۆۋەتلىك ئاسىيا تەنھەرىكەت مۇسابىقىسى، شۇنداقلا دۆلىتىمىز 2008-يىلى بېيجىڭ ئولىمپىك تەنھەركەت مۇسابىقىسىنى ئۆتكۈزگەندىن كېيىنكى يەنە بىر  قېتىملىق كاتتا ئۇنىۋېرسال مۇسابىقىە.
نەنجىڭ فۇزى بۇتخانىسى چىنخۇەي پانۇس كۆرگەزمىسىنىڭ بۇ يىل 28-نۆۋەت ئۆتكۈزۈلىشى بولۇپ، چاغاننىڭ بىرىنچى كۈنىلا 200 مىڭ ئادەم قېتىمدىن ئارتۇق ساياھەتچى كۈتىۋېلىندى، ھەر كۈنى نەق مەيداندا ۋەزىپە ئىجرا قىلىدىغان خەلق ساقچىلىرى 400 نەچچىگە كۆپەيتىلدى.
خەلق تۇرمۇشىنى ياخشىلاش ۋە جەمىيەت باشقۇرۇش ئىشلىرىدا يېڭىلىق يارىتىشقا يۈكسەك ئەھمىيەت بېرىپ جەمئىيەت ئىناقلىقى ۋە مۇقىملىقىنى قوغدىدى ؛
بارلىق نېفىتنى  قېزىپ بىرمەھەل ئېھتىياجتىن چىققان بىلەن ئامېرىكىنىڭ نېفىت ئىمپورت قىلىشقا تايىنىشىنى مەڭگۈ ئۆزگەرتكىلى بولمايدۇ.
بىخەتەرلىكنى ئويلىشىپ،  پەمىدور ئۇرۇشىغا قاتنىشىدىغان ئادەم سانى ئىلگىرى 45مىڭ ئادەمدىن 20مىڭ ئادەم ئەتراپىغا ئازايتىلدى.
«خارى پوتتېر» ناملىق چاتما ھىكايىنىڭ ئاپتورى، ئەنگىلىيىلىك ئايال يازغۇچى روللىن 14-چېسىلا ئامېرىكا نيويۇركتىكى بىر رايونلۇق سوت كوللىگىيىسىدە  سوتقا چىقىپ، شۇ جايدىكى ئامېرىكىلىق نەشىرىيات شىركىتىنى ئەيىلىدى.
.خېبېي ئۆلكىلىك قەلىبداشلار سەنئەت ئۆمىگى خېڭشۇي راۋياڭ كەنتىگە كېلىپ بۇ يەردىكى ئاممىغا مول مەزمۇنلۇق نومۇرلارنى ئورۇنلاپ بەردى .
مەزكۇر قوماندانلىق مەركىزى ئۈچ دەرىجىدىكى ئورگانغا ئايرىلىدۇ؛ئەڭ ئالي قوماندانلىق مەركىزى، ئۇ دۆلەت ۋە ئارمىيە رەھبەرلىرىدىن تەشكىللىنىپ، ئومۇمىيەتنى بىر تۇتاش باشقۇرىدۇ.
جياڭشى ئۆلكىسى ئېكولوگىيەنى پائال قوغداش ئۈچۈن  ئۆلكىدە تۇنجى « مۇھىت ئاسراش دوختۇرخانىسى» قۇردى، يېقىندا، ئالىي مەكتەپ ۋە ئىلمىي تەتقىقات يۇرتىدىكى 30 نەچچە  مۇتەخەسىس « مۇھىت ئاسراش دوختۇرلىرى» بولۇپ قالدى.
گۇاڭشىدىكى ھەرمىللەت خەلقى ئىناق بىرگە تۇرۇپ، قول تۇتۇشۇپ تەڭ ئىلگىرىلەپ، گۇاڭشىنىڭ تەرەققىياتىنىڭ ئۈزۈلمەس ھەرىكەتلەندۈرگۈچ كۈچىگە ئايلاندى، گۇاڭشى مىللەتلەر ئىتتىپاقلىقى تەرەققىياتى  بويىچە بەرپا قىلىش پائالىيىتىنى ئۈزلۈكسىز قانات يايدۇرۇپ، مىللەتلەر ئىتتىپاقلىشىپ بىر ئائىلە كىشىلەردەك بولۇشنى تېخىمۇ جانلاندۇرىدۇ.
بىزنىڭ نىشانىمىز  ئۇلۇغ  بولغانسىرى بۇرچىمىزمۇ شۇنچە جاپالىق بولىدۇ، بارلىق كىشىلەرنىڭ بىر نىيەت، بىر مەقسەتتە ئىگىلىك يارىتىشىغا شۇنچە مۇختاج بولىمىز.
تۆت ئاي سىناق قىلىش ئارقىلىق، ئالداپ كېتىلگەن يەتمىش مىليون يۈەن توڭلىتىۋېتىلدى، زىيانكەشلىككە ئۇچراش ئېھتىماللىقى بولغان 11 مىڭ  كىشى نەسىھەت بىلەن ئالدىنىشتىن توسۇپ قېلىندى.
قۇملۇقتا ماڭسا ۋاقىت ، كۈچ كېتىدۇ ، ئىش ئۈنۈمنى ئاشۇرۇش ئۈچۈن ئۇلار ئاستا-ئاستا قۇملۇقتا قونۇپ قالىدىغان بولدى ، بۇنىڭ ئۈچۈن ئۇلار مەخسۇس گەمە كولىدى .
بۇ يىل  ئىسپانىيە - جۇڭگو  دىپلوماتىك مۇناسىۋەت  ئورناتقانلىقىنىڭ 45 يىللىقى يەنى  ئىسپانىيەنىڭ سابىق پادىشاھى جۇئان كارلوس بىرىنچىنىڭ جۇڭگودا زىيارەتتە بولغانلىقىنىڭ 40 يىللىقى.
بۇ يىل 39 ياشقا كىرگەن ساۋ زىچېڭ 2004- يىلى ئالىي مەكتەپنى پۈتتۈرگەندىن كېيىن تارىم ئويمانلىقىغا بېرىپ، نېفىت، تەبىئىي گاز ئىزدەشنىڭ جاپالىق سەپىرىنى باشلىدى.
ئەرلەرنىڭ 3 تاخلاپ يىراققا سەكرەش ھەل قىلغۇچ مۇسابىقىسىدە ، دوڭ بىن ئۆزىنىڭ ئەڭ ياخشى نەتىجىسىنى يارىتىپ ، مىس مېدالغا ئېرىشتى ، بۇ جۇڭگو كوماندىسىنىڭ ئولىمپىك تەنھەركەت مۇسابىقىسىنىڭ مۇشۇ تۈرىدە ئەڭ ياخشى نەتىجىگە ئېرىشىشى .
رەئىس شى جىنپىڭ ئەرەب بىرلەشمە خەلىپىلىكىدىكى دۆلەت ئىشلىرى زىيارىتىنى ئاياغلاشتۇرغاندىن كېيىن يەنە سېنېگال جۇمھۇرىيىتىدە دۆلەت ئىشلىرى زىيارىتىدە بولىدۇ .
« بازا قىسىمى 40نەچچە يىللىق تەرەققىياتتا زورايدى، بۇنىڭدا ئۇلار پارتىيەنىڭ قوماندانلىقىغا بولغان قەتئىي ئىرادىسىگە تاياندى، باشتىن-ئاخىر پارتىيەنى مەركەز قىلىشتا تەۋرەنمىدى، ئوفىتسېر-ئەسكەرلەر ئۇرۇشتا غەلىبە قىلىش، قۇدرەتلىك قوشۇن قۇرۇش ئارزۇسىغا تاياندى، قەيسەرلىك بىلەن كۈرەش قىلىش ئىستىلى ۋە ئۆزىدىن كېچىپ تەقدىم قىلىش روھىغا تاياندى.»
سۈپەت ئۆزگىرىشى، ئۈنۈم ئۆزگىرىشى، ھەرىكەتلەندۈرگۈچ كۈچ ئۆزگىرىشىنى تەشەببۇسكارلىق بىلەن ئىلگىرى سۈرۈپ، شەھەر ئىقتىسادىنىڭ زىچلىقىنى ئاشۇرۇش، سېلىنمىنى ئاشۇرۇپ، ئۈنۈم ھاسىل قىلىش ، دۇنياۋى بايلىقىنى تەقسىملەش ئىقتىدارىنى ئۆستۈرۈش، يېڭىلىق يارىتىش مەنبەسىنى كۆپەيتىش ئىقتىدارىنى ئاشۇرۇش جەھەتلەردە كۈچ سەرپ قىلىپ، زامانىۋى ئىقتىساد سىستېمىسى قۇرۇشنى تېزلىتىش كېرەك.
چاڭجياڭ دەرياسىنىڭ تۆۋەنكى ئېقىمىغا جايلاشقان جياڭسۇ ئۆلكىسى بۇلغىمىنى تۈزەش، تىپ ئۆزگەرتىش قاتارلىق تەدبىرلەر ئارقىلىق قۇرۇلمىنى تەڭشەپ، ياخشى ئورۇنلاشتۇرۇپ، مۇھىت بىلەن تەرەققىيات ئوتتۇرىسىدىكى تەڭپۇڭلۇقنى ۋە يۇقىرى سۈپەتلىك تەرەققىيات يېڭى يولىنى تېپىپ چىقتى.
سۆھبەتكە دۆلەت ھالقىغان داڭلىق شىركەتنىڭ مەسئوللىرى، خەلقئارادىكى داڭلىق بىلىم يۇرتى، تەتقىقات ئورگىنى خادىملىرى ھەمدە خەلقئارا تەشكىلاتلارنىڭ يۈزدىن ئارتۇق مەسئولى قاتناشتى.
ئىقتىسادى قۇرۇلمىنى تەڭشەش ئىقتىسادنىڭ تەرەققىيات شەكلىنى ئۆزگەرتىشنىڭ مۇھىم مەزمۇنى بولۇپ، سىجىل تەرەققىياتنى ئىلگىرى سۈرۈشتە ئاچقۇچلۇق ، ھەل قىلغۇچ رول ئوينايدۇ .
لۈ ئەپەندى ۋاخاخا شىركىتى  ئىشلەپچىقارغان دەپ قارىغان  ئىچىملىك ۋاڭ خاخا يىمەكلىك چەكلىك شىركىتىنىڭ مەھسۇلاتىغا ئايلانغان ئىدى، مۇشۇ بىر خەت سەۋەپلىك بۇ ئىككى مەھسۇلات زور دەرىجىدە پەرىقلەنگەن.
لاتۋىيە جۇڭگو كارخانىلىرىنىڭ لاتۋىيەگە مەبلەغ سېلىپ تىجارەت قىلىشىغا مۇقىم مۇھىت يارىتىپ ، جۇڭگو كارخانىلىرىنىڭ ئوتتۇرا شەرقىي ياۋرۇپا بازىرىغا كىرىدىغان دەرۋازىسى بولۇشنى خالايدۇ.
ۋەكىللەرنىڭ ۋە مەخسۇس كومىتېتلارنىڭ  رولى تولۇق جارى قىلدۇرۇش  قاتارلىق جەھەتلەردە  يېڭى نەتىجىلەرگە ئېرىشتى .
«ئىلگىرى يولمۇ ، توكمۇ يوق ، نۇرغۇن پۇقرالار پاخال ئۆيلەردە ئولتۇراتتى ، 40 كۋادىرات مېتىر كېلىدىغان كىچىككىنە ئۆيدە 3 ئەۋلاد  بىرگە تۇراتتى .»
دېلوغا مەسئۇل گۇڭئەن خادىمىنىڭ تۇنۇشتۇرۇشىچە، دېلو مەلۇم قىلغان ياشانغانلار ئىككى مىڭدىن ئاشقان، جياڭشى تيەندى زىرەن ساغلاملىق كۈتىنىش پاي  چەكلىك شىركىتىنىڭ مەسئۇلى لى گوجيەن ئاۋىستىرالىيەگە قېچىپ كەتكەن بولۇپ، ئۇ ئېلىپ كەتكەن مەبلەغ قايتۇرۋېلىنىش باسقۇچىدىكەن.
ئاممىغا تەستىقلاش مۇلازىمىتىدە قولايلىق يارىتىش ئۈچۈن جايلار يەنە نۇرغۇن ئۇسۇللار ئۈستىدە ئىزدەندى .
پارتىيە نىزامى پارتىيىنىڭ تۈپ چوڭ قانونى، پارتىيىنى ئومومىيۈزلۈك قاتتىق باشقۇرۇشتا تايىنىدىغان ئومومىي ئاساس ۋە قوللانما شۇنداقلا پۈتكۈل پارتىيە ئەزالىرىنىڭ سۆز-ھەرىكىتىنىڭ ئومومىي قائىدىسى ۋە ئومومىي قىبلىنامىسى.
2007-يىلى شۇ جايدىكى كۆپلىگەن تاراتقۇلار جاۋ گۇاڭجۈننىڭ ئىش-ئىزلىرى ھەققىدە خەۋەر بەردى، ئۇنىڭ ھاياتلىق قىزىق لىنىيەسى گۇاڭجۇ شەھىرىدە ھەممىگە تونۇلدى، جاۋ گۇاڭجۈن ئىلگىرى-كېيىن بولۇپ مەملىكەت بويىچە مۇنەۋۋەر پىدائىي، مەملىكەتلىك ئەخلاق نەمۇنىچىسى قاتارلىق شەرەپلىك ناملارغا ئېرىشتى، كىشىلەر ئۇنى يېقىملىق ھالدا جۈن ئاكا دەپ چاقىرىدىغان بولدى.
ئىلمىي ۋە دېموكراتىك قانۇن چىقىرىشنى چوڭقۇر ئىلگىرى سۈرۈپ، ھەر قايسى تەرەپلەرنىڭ پىكىرىنى ئاڭلاپ ۋە ھۆرمەتلەپ، قانۇن چىقىرىشتا ماسلاشتۇرۇش بىلەن قانۇن چىقىرىشتا كېڭىشىنى كۈچەيتىپ، ئەڭ چوڭ ئورتاق تونۇش ھاسىل قىلىش كېرەك.
شى جىنپىڭ پارتىيە 18-نۆۋەتلىك مەركىزى كومىتېتى 6-ئومومى يىغىنىنىڭ روھىنى تەشۋىق قىلىش خىزمىتىنى ياخشى ئىشلەش توغرىسىدا مۇھىم يوليورۇق بەردى .
بۈگۈن دېھقانلار كالېندارى بويىچە 3- ئاينىڭ 23- كۈنى، يەنى مازۇ تۇغۇلغانلىقىنىڭ 1050 يىللىق خاتىرە كۈنى.
جوڭگۇنىڭ يۇقىرى سۈرئەتلىك تۆمۈر يول مۇساپىسى شاڭخەي - كۇنمىڭ  لىنىيىسى بىلەن بېيجىڭ - شاڭخەي لىنىيىسنى ئۆز ئىچىگە ئالغان ھالدا 22مىڭ كېلومتېرغا يېتىدۇ.
جۇڭگو خەلق سىياسىي مەسلىھەت كېڭىشى دېگەن بۇ تەنتەنىلىك نام، ئۇنىڭ خارەكتىرى ۋە رولىنى ئېنىق ئايرىپ بەردى، بۇ نامنى ، بۇ تۈزۈمنىڭ بىزگە ئاتا قىلغان بۇرچىنى توغرا ئىگىلىشىمىز شەرت.
شى جىنپىڭ مۇنداق دېدى : ھازىر جۇڭگۇ خەلقى جۇڭخۇا مىللەتلىرىنىڭ ئۇلۇغ گۈللىنىشىنى ئىشقا ئاشۇرۇشتەك جۇڭگۇ ئارزۇسى ئۈچۈن كۈرەش قىلىۋاتىدۇ .
كىتابنى ياپقاندىكى كەڭلىكى 1.54مېتىر، ئاچقاندا 3.08مېتىرغا يېتىدۇ.
دوكىلاتتا مۇنداق دېيىلدى : ئۆتكەن بىر يىلدا مەملىكەتلىك خەلق قۇرۇلتىيى پارتىيەنىڭ رەھبەرلىكىدە چىڭ تۇرۇپ، خەلق ئۆزىگە ئۆزى  خۇجايىن بولۇش بىلەن دۆلەتنى قانۇن ئارقىلىق ئىدارە قىلىشنى جانلىق بىرلەشتۈرۈپ ، تۆت ئومومىيۈزلۈك ئىستراتېگىيەلىك ئورۇنلاشتۇرىشىنىڭ تەلىپىگە ئاساسەن ،  خىزمەت ھوقوقىنى قانۇن بويىچە يۈرگۈزۈپ خىزمەتلەرنى پائال قانات يايدۇردى .
ئىدىيىۋى تەربىيەنى چىڭ تۇتۇشقا ئەھمىيەت بېرىپ، باش شۇجى شى جىنپىڭنىڭ بىر يۈرۈش مۇھىم سۆزىنىڭ روھىنى چوڭقۇر ئۈگىنىپ، غايە ئىتىقادنى مۇستەھكەملەپ، پارتىيە ئىچىدىكى سياسى مەدەنىيەت قۇرۇلۇشنى كۈچەيتىش لازىم.
شۇ چاغدا ۋاڭ دىڭگو 94 ياشتا بولۇپ، 1935-يىلى قىزىل تۆتىنچى يۆنىلىش ئارمىيىسىنىڭ جيالىڭجياڭ دەرياسىدىن بۆسۈپ ئۆتۈش  جېڭىنى  تېما قىلىپ سىزغان ئىدى.
تېنچ ئوكياندىكى ئارال دۆلەتلىرىنىڭ تەرەققىياتى بولمىسا، ئاسىيا تېنچ ئوكيان رايونىنىڭ ئومومىي تەرەققىياتى ۋە گۈللىنىشى بولمايدۇ.
چاغانلىق يولوچى توشۇش مەزگىلىدە، نەنجىڭدىن كونمىڭ، فۇجۇ، خۇنەنلەرگە يولوچى توشۇش بېسىمى سەل پەسىيىدۇ.
يېقىندا مەركىزىي كومىتېت تارقاتقان« جۇڭگو كوممۇنىستىك پارتىيەسىنىڭ پاك ، ئىنتىزامچان بولۇش مىزانى » ، « جۇڭگو كومپارتىيەسنىڭ ئىنتىزام چارىسى نىزامى»87 مىليوندىن ئارتۇق كومپارتىيە ئەزاسىغا ئىدىيە ۋە ھەرىكەت مىزانى تۈزۈپ بەردى.
دەسلەپكى تەكشۈرۈش نەتىجىسىدە كۆرسىتىلىشىچە ،  مەلۇم بىر كىشى ساماۋىنىڭ كىملىكىنى ئوغۇرلۇقچە ئىشلىتىپ ،  پارتلاتقۇچ دورا سېلىنغان  خالتىنى پوچتىدىن   سالغان .
«مىسىردا جان باققىلى بولمايدۇ، شۇڭا لىۋىيەگە كەلدۇق، مەن ياغاچچى، ئارىمىزدا سۇ تۇرۇببا ئىشچىسىمۇ بار، بىز چەتئەلگە چىقىپ ئىشلىسەك پۇل ئايرىۋاشلاش نىسبىتىمۇ مۇۋاپىقكەن، كۆپرەك پۇل تاپالايدىكەنمىز.»
قايتا تەكشۈرۈشتىكى مەقسەت، قانۇننىڭ ئادىللىقىدىن گۇمانلانغانلىققا قاراپ تۇرالمىغانلىقىمىز ئەمەس ، بەلكى قانۇننىڭ نوپۇزى ۋە خەلقنىڭ ھوقوقىغا يۈكسەك مەسئۇل بولغانلىقىمىز ئۈچۈندۇر .
2-چېسىلادىن باشلاپ قېلىن قار يېغىپ تېمپۇراتۇرا تۆۋەنلەپ كەتكەچكە،  قىسمەن رايونلارنىڭ توك ئىشلىتىش مىقدارى توقتىماي يۇقۇرى رىكورت يارىتىپ ، توك كەمچىل بولۇش ئەھۋالى كۆرۈلدى.
بىز زامانىۋىلاشتۇرۇشقا، دۇنياغا، كەلگۈسىگە، مىللەتكە، ئىلىم-پەنگە، ئاممىغا يۈزلەنگەن سوتسىيالىستىك مەدەنىيەتنى تەرەققىي قىلدۇرۇشتا ئىجادىي ئۆزلەشتۈرۈش، ئىجادىي تەرەققىي قىلدۇرۇشقا مۇھتاج، تۈزۈلمە مېخانىزىمىدىن ئاساسنى پۇختىلاپ، ھاياتىي كۈچنى ئۇرغۇتقاندىلا مەدەنىيەت ئىجادىيىتى ۋە مەدەنىيەتتە يۈكسېلىشنى ئۈزلۈكسىز ئىلگىرى سۈرگىلى بولىدۇ.
2010-يىلى 7-ئايدا، روسىيە بىلەن ئامېرىكا ئۆز-ئارا تۇتۇپ قالغان تۆت  ۋە 10 جاسۇسلۇق گۇماندارىنى قارشى تەرەپكە ئۆتكۈزۈپ بەردى.
تۈنۆگۈن چۈشتىن كېيىن سائەت 12 دىن 40 مىنۇت ئۆتكەندە، خاربىن شەھىرىدىكى بىر سودا ۋە تۇرالغۇ ئۆي بىناسىغا  ئوت كەتتى.
مۇزىكا پۈتۈن دۇنيادىكى ئوخشىمىغان مەدەنىيەت ۋە    تىل ئوتتورىسىدىكى ئەل رىشتىسىنى تۇتاشتۇرۇشنىڭ ئەڭ ياخشى ۋاستىسى.
« خاڭجۇ باشلىقلار يىغىنىدا جۇڭگو كۈچلۈك مەسئۇلىيەتچانلىقى ، دۇنيا ئىقتىسادىنىڭ تەرەققىياتىنى تىرىشىپ ئىلگىرى سۈرىدىغانلىقى ، ئەركىن سودىنى قوغدايدىغانلىقى ، سودا قورۇمىچىلىقىنىڭ باش كۆتۈرۈشىگە قارىشى تۇرۇش خاھىشىنى نامايەن قىلدى، شۇ چاغدا ياۋرۇپا، ياپۇنىيە ئىقتىسادى چىكىنىۋاتقان، ئامېرىكىنىڭ تەرەققىيات ۋەزىيىتى ئانچە ياخشى ئەمەس بولغاچقا جۇڭگو دۇنيا ئىقتىسادىنىڭ ماتۇرىغا ئايلاندى، ھازىرمۇ ھەم شۇنداق بولىۋاتىدۇ.»
«دېمەك يامغۇر سۈيى بىلەن پاسكىنا سۇنى ئايرىش قارا سېسىق سۇنى تۈزەشتە ئىنتايىن مۇھىم؟»
مۇخبىرنىڭ ئىگلىشىچە، ليۇجياشەن كەنتىدىكىدەك ئەھۋال بۇ يەردە خېلى كۆپكەن، قائىدە بويىچە سېتىپ بولالمىغان چىلاننى  پىششىقلاپ ئىشلىگىلى بولىدۇ ، لېكىن مۇخبىرنى ھەيران قالدۇرغىنى  چىلان ئۆستۈرگەن دېھقانلار چىلان پىششىقلاپ ئىشلەش كارخانىلىرىغا بىر جىڭمۇ چىلان ساتالماپتۇ .
«يەرلىكتىكى قوراللىق ساقچى قىسىمدا تۇرىۋاتقان ۋاقتىمدا يېڭى ئەسكەرلەرنى كۈتۈۋالغان كادىر بىزگە، بىزنىڭ قىسىمنى رەئىس شى جىنپىڭ كۆزدىن كەچۈرگەن، دېدى.كېيىن مۇشۇ ليەندۇيگە تەقسىم قىلىنىپ خۇشال بولدۇم ھەم پەخىرلەندىم، شەرەپ ھېس قىلدىم.»
فىرانسىيەنىڭ پارىژ زامانىۋى سەنئەت موزىيىدىكى 5 پارچە داڭلىق رەسىمنىڭ ئوغرىلىنىش دېلوسىنى تەكشۈرۈشكە مەسئۇل خىزمەتچىلەر 20 ماي مۇنداق دېدى: بىخەتەرلىك ئاگاھلاندۇرۇش سىستېمىسىدە كاشلا كۆرۈلگەنلىكى شۇ كۈنى ئەتىگەندە رەسىملەرنىڭ ئوغرىلىنىش سەۋەبلىرىنىڭ بىرى .
تەييۇەن ئېغىر تىپتىكى ئۈسكۈنىلەر گوروھى مۇستەقىل يېڭىلىق يارىتىشقا تايىنىپ، ئېلىمىز بويىچە ئەڭ چوڭ قىزىش ماشىنىسى ئىشلەپچىقىرىش بازىسىنى قۇردى ، ھەمدە سەنشيا ئېلېكتر ئىستانسىسىدا ئاسما كىران، مۇققەددەس كېمە  قويۇپ بېرىش مۇنارى، چوڭ تىپتىكى ئايلانما سەھنە قاتارلىقلارنى ياساش قاتارلىق 220 تۈردە دۆلەت ئىچى ۋە سىرتىدا بىرىنچى بولدى.
17- چېسىلا شىزاڭ ئالى ۋىلايىتى رىتۇ ناھىيىسى دوڭرۇ يېزىسى ئەتراپىدىكى مۇزلۇقتا قار كۆچۈپ ، 9 چارۋۇچىنىڭ دېرىكى بولمىدى ، بىر قىسىم قاتناش قۇراللىرى ۋە ھايۋانلار كۈمۈلۈپ قالدى .
بۇنىڭدىن ئىلگىرى روسىيە غەربنىڭ جازاسىغا ماسلىشىش ئۈچۈن ئىرانغا S-300تىپلىق باشقۇرۇلىدىغان بومبا سېتىپ بېرىشنى توختىتىپ ئىراننىڭ نارازىلىقىنى قوزغاپ قويغان ئىدى .
ئەمىليەتتە ئەڭ مۇھىمى ئىلىم پەن لېكسىيىسىدە كۆپچىلىككە خۇشاللىق ئاتا  قىلىش كېرەك ، بۇ ناھايىتى مۇھىم .
يېقىندا  قالپاق زاۋۇتى، سىر زاۋۇتى ۋە قەغەز زاۋۇتى قاتارلىق  بىر نەچچە كارخانىلار بۇ كەنتكە جايلاشماقچى بولغاندا، كەنتتىكىلەر كارخانا بۇلغانمىلىرى بىلەن كەنت ئىكولوگىيە قۇرۇلۇشى پىلانى ئۆز- ئارا زىت ئىكەن دەپ قاراپ ئۇلارنى رەت قىلدى، بۈگۈنكى كۈندە بۇ ئىكولوگىيە قۇرۇلۇشى پىلانى خۇاڭلياڭ كەنتىنڭ قائىدە- تۈزۈملىرىنىڭ بىرى بولۇپ قالدى.
بۇ فۇجيەن ئۆلكىسى  چۇەنجۇ شەھىرى  چۇەنگاڭ رايونىدا ئۆتكۈزۈلگەن  تۈنجى نۆۋەتلىك توردا ۋاپادارلىقنى باھالاش مەدەنىيەت كۆرىكى ، سەھنىدە ، نەچچە ئون كىشى   ئاتا - ئانىلىرىنىڭ پۇتىنى يۇيۇپ ، نۇرغۇن ئادەمنى قاتتىق تەسىرلەندۈردى .
ب د ت ، شاڭخەي ھەمكارلىق تەشكىلاتى قاتارلىق كۆپ تەرەپ رامكىسى ئىچىدە ئىككى دۆلەت ناھايىتى زىچ ھەمكارلاشتى.
كونسېرۋا ھەيكەللەر   كۆرگەزمىسىمۇ ئاممىغا ئېچىۋېتىلىدۇ ، بىراق كۆرگەزمىنى كۆرمەكچى بولغانلار ئاز دىگەندە بىر كونسېرۋا يىمەكلىك ئىئانە قىلىشى كىرەك .
مائارىپ مىنىستىرلىقى بۈگۈن «نۆۋەتتىكى يۇقۇملۇق كېسەللىكنىڭ ئالدىنى ئېلىش-كونترول قىلىش خىزمىتىنى ياخشى ئىشلەش توغرىسىدا ئۇقتۇرۇش» تارقىتىپ، مەكتەپ ئاشخانىلىرىدىن يېمەكلىك سېتىۋېلىش، پىشۇرۇش، ساقلاش قاتارلىق ھالقىلاردىكى بىخەتەرلىك، باشقۇرۇشىنى چىڭ تۇتۇشنى.
ئۇلار دۇنيانىڭ دېققىتىنى تارتىدىغان دەرىجىدىن تاشقىرى قۇرۇلۇش قىلىدۇ،     2016-يىلى ئۇلار مول نەتىجىلەرگە ئېرىشتى،   2017-يىلى ئۇلار تىرىشىپ ئالغا ئىلگىرلىدى
ئۇ ھۆددىگەر ئېلىپ كەلگەن ھاراق ، تاماكا قاتارلىق نەرسىلەرنى ئالغىلى ئۇنىمايدۇ ، نۇرغۇن يىللار ئۆتتى ، ئۇنىڭ نازارەتچىلىكىدە ياسالغان بۇ يول ھېلىمۇ ئاپتوموبىل بېكىتى ۋە پويىز ئىستانسىسىغا بارىدىغان ئەڭ ئالدىراش قاتناش يولى ھېسابلىنىدۇ.
چاغان يېتىپ كەلدى، رېنفا دېھقانچىلىق ماشىنىلىرى كوپېراتىپىنىڭ كېڭەش باشلىقى لى فېڭيۈ يىلدا بىر قېتىم ئېچىلىدىغان كوپېراتىپ ئەزالىرى ۋەكىللەر   يىغىنىنى ئاچتى.
21 ياشلىق روبس مۇسابىقىدىن كېيىن، ئۆزىنىڭ ئەرلەر  110مېتىرغا توساقتىن ئاتلاپ يۈگرەش دۇنيا رېكورتىنى ياراتقاندىن كېيىنكى نىشانىنىڭ بېيجىڭ ئولىمپىك تەنھەرىكەت مۇسابىقىسىدە ياخشى نەتىجىنى قولغا كەلتۈرۈپ، ئەنگىلىيىلىك ماھىر جېكسون  زال ئىچى 60 مېتىرغا توساقتىن ئاتلاپ يۈگۈرۈشتە ساقلاپ كېلىۋاتقان    يەتتە سېكونت 30 دەقىقىلىق دۇنيا دىكورتىنى بۇزۇش ئىكەنلىكىنى بىلدۈردى .
ب د ت باش كاتىپىنىڭ ئالاھىدە  ئەلچىسى كېبول شۇ كۈنى مىللەتلەر ئىتتىپاقلىقى ھۆكۈمىتىگە رەسمىي ھوقۇق بېرىش ئۈچۈن ، لىۋىيە مىللىي قۇرۇلتىيىنى  تېزدىن ئاۋازغا قويۇشقا ھەيدەكچىلىك قىلدى .
ۋاڭ لىن ئۆزىنى ھەرخىل ماھارەتلەرگە ئىگە دەپ قالماي، يەنە مۇرەككەپ ۋە داۋالاش تەس بولغان كېسەللەرنى داۋالىيالايدىغان ئۇستا تىۋىپ بولىمەن دېدى.
شياڭگاڭ  ، ئاۋمىندىكى ھەرساھە زاتلار  رەئىس شى جىنپىڭنىڭ دۆلەتكە يېتەكچىلىك قىلىپ ، تېخىمۇ زور تەرەققىياتلارنى قولغا كەلتۈرۈپ ، يېڭى دەۋردىكى ئۇلۇغ جۇڭگو ئارزۇسىنى ئىشقا ئاشۇرىدىغانلىقىغا ئىشىنىدىغانلىقىنى بىلدۈردى .
ئەنئەنىۋى تارقىلىش ئۇسۇلىغا سېلىشتۇرغاندا ، شەھۋانىي ئۇچۇرلارنىڭ ئۈندىداردىكى تارقىلىش سۈرئېتى تېخىمۇ تېز ، تېخىمۇ كەڭ ۋە يوشۇرۇن بولىدۇ ، مۇشۇ ئالاھىدىلىكلەرگە ئاساسەن ، مەملىكەت بويىچە شەھۋانىيلىققا ، قانۇنسىزلىققا زەربە بېرىش ئىشخانىسى باش بولۇپ ، توردا شەھۋانىي ئۇچۇرلارغا زەربە بېرىشنى ئۈندىدار ساھەسىگە كېڭەيتتى .
يۇرت - ماكانىنى قايتا قۇرۇشتا بېخەتەرلىك بىرىنجى ، سەھىيە يۇقۇم مۇداپىئەسىدىن سىرت تېخىمۇ مۇھىم بولغىنى بۇ يىلقى كەلكۈن مەزگىلى تېخى ئاخىرلاشقىنى يوق، كەلكۈن يەنە كېلىشى مۇمكىن، شۇنىڭ ئۈچۈن، باش شۇ جى شى جىنپىڭ كەلكۈندىن مۇداپىە كۆرۈش، خەتەردىن قۇتقۇزۇش خىزمىتىگە قويغان ئالتە تۈرلۈك تەلەپتە ئارمىيە خەلق بىرلىشىپ مۇداپىئە كۆرۈشنى ئالاھىدە تەكىتلىدى.
يېڭى تۈزۈمگە ئاساسەن، دورىدىن پايدا ئالىدىغان ئەھۋال ئاساسەن تۈگىتىلدى.
قار يېغىپ  يول  توسۇلۇپ قېلىشتىن بۇرۇن يۇرتىغا قايتىپ ئىشلەمچىلەرگە ئىش ھەققىنى بېرىش ئۈچۈن ، خۇبېي ۋۇخەندىكى قۇرۇلۇش سودىگىرى سۈن شۈيلىن سەپەردە قاتناش ھادىسىسىگە يولۇقۇپ ، بەخىتكە قارشى قازا قىلدى ، ئىنىسى سۈن دوڭلىن ئاكىسىنىڭ ئارزۇسىغا تەشەببۇسكارلىق بىلەن ۋارىسلىق قىلىپ ، چاغان ھارپىسىدىن بۇرۇن بېرىپ ئىش ھەققىنى يۇرتداشلىرىغا تولۇق تارقىتىپ بەردى .
جۇڭگو ھۆكۈمىتى ۋە خەلقى سىنگاپور ھۆكۈمىتى ۋە خەلقى بىلەن بولغان دوستلۇق ۋە ھەمكارلىقنى ئىزچىل قەدىرلەپ كەلدى .
ئامېرىكا ئارمىيەسىنىڭ «ۋەتەنپەرۋەر-3»ناملىق باشقۇرۇلىدىغان بومبىسى- ھاۋادىن مۇداپىئەلىنىدىغان «ۋەتەنپەرۋەر» ناملىق يۈرۈشلۈك باشقۇرۇلىدىغان بومبىنىڭ ئەڭ يېڭىسى بولۇپ، دۇنيا بويىچە ئەڭ ئىلغار، زەربە بېرىش ئىقتىدارى ئەڭ كۈچلۈك ھاۋادىن مۇداپىئەلىنىدىغان باشقۇرۇلىدىغان بومبا سىستېمىسى.
<<بۈگۈنكى مۇشۇنداق تارىخىي بۇرۇلۇش نۇقتىسىدا بىزنىڭ بۇ يەرگە كەلگەنلىكىمىز جۇڭگونىڭ يېڭى دەۋردە يېڭى سەپەرگە ئاتلانغانلىقىنى چۈشەندۈرىدۇ >>
«مېنىڭچە ناھايىتى چوڭقۇر سۆزلەنگەن، ئاخبارات خىزمەتچىلىرى ئىشلارنى چۈشىنىشتە، ماركىسىزىملىق ئاخبارات قارىشى بىلەن خەۋەر قىلىدىغان شەخس ۋە ئىشلارغا قانداق   ھۆكۈم قىلىشى كېرەكلىكى چۈشەندۈرۈلگەن.»
ئەسەرنىڭ تەسىرچانلىقىدىن پايدىلىنىپ يادرولۇق قىممەت قارىشىنى ئەتراپلىق سىڭدۈرۈش كېرەك، بۇ ۋەكىل ۋە ئەزالارنىڭ ئورتاق تونۇشى .
سىرى يېشىلگەن بۇ يېڭى ھۆججەتكە  UFO مۇتەخەسىسلىرى مۇنداق دەپ قارىغان: بۇ ۋەقە سۇغۇق مۇناسىۋەتلەر ئۇرۇشى مەزگىلىدە يۈز بەرگەن، بۇ ئامېرىكا ئارمىيىسىنىڭ  سۆۋېت ئىتتىپاقىنىڭ قارشىلىشىش ئىقتىدارىنى سىناش ئۈچۈن ئېلىپ بارغان كۆرۈنمەس ئايرۇپىلان سىنىقى بولۇشى مۇمكىن دەپ قارىغان.
ماقالىدا مۇنۇلار تەكىتلەندى : ئۆتمۈش بىلەن كەلگۈسىنىڭ كېسىشىش نۇقتىسىدا تۇرغان جۇڭگو   مىسلىسىز پۇرسەتكە ئېرىشتى ، ھەم مەملىكەت ئىچىدىكى مىسلىسىز ئېغىر ۋەزىپىدىن ئىبارەت خىرىسقا  ، دۇنيادا چوڭقۇر ئۆزگۈرۈشلەر بولىۋاتقان داۋالغۇپ تۇرغان ۋەزىيەتكە دۇچ كەلمەكتە .
كورىيەنىڭ قاتتىق پوزېتسىيەسى ئالدىدا، كىشىلەر چاۋشيەننىڭ تېخىمۇ قاتتىق ئىنكاس قايتۇرىشىدىن ئەندىشە قىلىشتى .
6-ئاۋغۇست سائەت 16گە قەدەر يەر تەۋرەشتە كۆمۈلۈپ قالغان 600دىن ئارتۇق ئادەم  قۇتقۇزۇپ چىقتى، 2993 يارىدارنى قوبۇل قىلىپ داۋالىدى .
شۇنىڭ بىلەن بىر ۋاقىتتا يىغىندا مۇنۇلار كۆرسىتىلدى، پۇل- مۇئامىلە، يەر، مالىيە-باج، مەبلەش سېلىش، قانۇن چىقىرىش قاتارلىق ۋاستىلەرنى ئۇنىۋېرسال قوللىنىپ، دۆلەت ئەھۋالىغا ئۇيغۇن، بازار قانۇنىيىتىگە ماس كىلىدىغان ئۇل خاراكترلىق تۈزۈم ۋە ئۇزۇن مۇددەتلىك مىخانىزمنى تەتقىق قىلىپ تۇرغۇزۇشنى تېزلىتىش .
كەلگۈسىدە دۆلىتىمىز ئەتراپ ، «بىر بەلباغ، بىر يول» ۋە دۇنيا مىقياسىدىن ئىبارەت ئۈچ  قاتلام بويىچە ئەركىن سودا رايونى قۇرۇلۇشىنى ئورۇنلاشتۇرىدۇ.
پېرۇنىڭ 1524 نەپەر سوقما مۇزىكا ھەۋەسكارى تۈنۈگۈن پايتەخت لىمانىڭ شەھەر مەركىزىدىكى قورال مەيدانىغا يىغىلىپ، كاخون دۇمبىقى چېلىپ، كاخون دۇمبىقىنى تەڭ چېلىش جىنىس دۇنيا رېكورتىنى يەنە يېڭىلىدى، بۇلتۇرقى رېكورت 1476 ئادەم ئىدى.
سانجى شەھىرى يەنئەن شىمالىي يولىدىكى جىنلىڭ مەھەللىسىدە، ئۈچ رەت بويىچە تىزىلغان 10 مېتىر ئۇزۇنلۇقتىكى ئۈستەللەر ئادەملەر بىلەن لىق تولغان ئىدى.
تولغىما ئۇسسۇل مۇزىكىسىنىڭ دۇنياغا كېلىشى ۋە تەرەققىياتى بىر خىل مۇھىم ساز – ئېلىكترونلۇق گىتار بىلەن زىچ مۇناسىۋەتلىك ئىكەنلىكىنى ھەمىمىز بىلىمىز.
نۆۋەتتە لوچۈەن ئالمىسىدىن يىلىغا850 مىڭ توننا ھوسول ئالغىلى بولىدۇ ،  ئومۇمىي كىرىم 4 مىليارت يۈەن بولۇپ، 20 نەچچە دۆلەت ۋە رايونغا ئېكىسپورت قىلدى ، 12000 كىشىنى نامراتلىقتىن قۇتۇلدۇردى.
ئېلىمىزنىڭ پەلسەپە ئىجتىمائىي پەن ساھەسىدە بەلگىلىك نەتىجە يارىتىش ئۈچۈن، چوقۇم خەلقنى مەركەز قىلىشتىن ئىبارەت تەتقىقات يېتەكچىلىكىدە چىڭ تۇرۇش كېرەك.
بۇ گۇاڭجۇدىكى مەلۇم ئۈچ A دەرىجىلىك دوختۇرخانىنىڭ ئامبولاتورىيە زالى، داۋالاش ماجىراسى قىلغۇچىلار پوجاڭزىنى تىببى خادىملار ۋە كېسەل كۆرسىتىۋاتقان بېمارلارغا ئاتتى، دوختۇرخانىنىڭ سىرتىدا، نەچچە ئون   داۋالاش ماجىراسى قىلغۇچىلار داقا-دۇمباق چېلىپ ،  ئەرۋاھ تاختىسى   قويدى .
پارتكوم رەھبەرلىك قىلىش ، ھۆكۈمەت مەسئۇل بولۇش ، ئالاقىدار تارماقلار ماسلىشىش ، پۈتۈن جەمئىيەت ئورتاق ھەمكارلىشىشتەك مىللەتلەر خىزمىتى ۋەزىيىتىنى شەكىللەندۈرۈش لازىم .
شىمالى ئامېرىكىغا قارىغاندا، كارىب رايونىنىڭ يەر پوستى ھەر يىلى شەرققە 2 سانتىمېتىر سۈرۈلىدۇ ھەمدە ھايتىنىڭ جەنۇبىدىكى ئېنرىكورو ئۈزۈلمە بەلۋىغىدىن كېسىپ ئۆتىدۇ، ئىلگىركى 250 يىلدا ھەركەت بولۇپ باقمىغاچقا، نۇرغۇن ئېنېرگىيە يىغىلىپ قالغان، شۇ سەۋەپتىن بىر مەيدان ئاپەت يۈز بېرىشتىن ساقلىنىش تەس ------ پاۋىل مېئىن  2008-يىل.
ئىلى ئوبلاستتى ئىشقا ئورۇنلىشىشنى ئىلگىرى سۈرۈشنى ئىقتىسادىي، ئىجتىمائىي تەرەققىياتتا ئالدىنقى ئورۇنغا قويۇپ، ھەر مىللەت ئاممىنى تېخىمۇ يۇقىرى سۈپەتلىك ۋە تېخىمۇ تولۇق ئىشقا ئورۇنلاشتۇرۇشنى تۈرلۈك ئاماللار بىلەن ئىلگىرى سۈرۈپ، ھەر مىللەت ئاممىنىڭ ئېرىشىش تۇيغۇسى ۋە بەخت تۇيغۇسىنى ئۈزۈكسىز كۈچەيتتى.
چوقۇم مۇستەقىل، ئۆزىگە-ئۆزى خوجا بولغان تىنچ دىپلوماتىيە فاڭجېنىدا چىڭ تۇرۇپ، تىنچ تەرەققىيات يولىدا مېڭىش، خەلقئارا ئادالەتنى ياقلاش، خەلقئارا مۇناسىۋەتنى دېموكىراتىيەلەشتۈرۈشنى ئىلگىرى سۈرۈپ ، تەڭ مەنپەتلىنىشنى تەشەببۇس قىلىش ، ئىقتىساد دىپلوماتىيەسىنى ئىلگىرى سۈرۈپ، يەر شارى دۇچ كېلىۋاتقان نۇرغۇن خىرىسلارغا ئورتاق تاقابىل تۇرۇش ، ئىنسانلار مەدەنىيىتىنىڭ تەرەققىياتىنى ئىلگىرى سۈرۈپ ، ئېلىمىز تاشقى ئىشلار خىزمىتىدە يېڭى ۋەزىيەت ئۈزلۈكسىز يارىتىش كېرەك .
« سۆھبەت يىغىنىدا رەئىس شى جىنپىڭ  « ھاجەتخانا ئىنقىلابىي» قىلىش مەسىلسىنى تىلغا ئالدى، رەئىس شى جىنپىڭنىڭ مۇشۇنداق كىچىك ئىشلاردىمۇ خەلقنى ئويلايدىكەن.»
بۇ يىلقى 2 يىغىندا، ۋەكىللەر ۋە ئەزالار  «2013-يىللىق خەلق ئىگىلىكى ۋە ئىقتىسادىي تەرەققىيات  پىلانى لايھەسى توغرىسىدىكى دوكلات » قا يېقىندىن كۆڭۈل بۆلدى.
ئىنتىزامغا خىلاپلىق قىلغانلارنى قاتتىق تەكشۈرۈپ بىر تەرەپ قىلىپ «تۆت خاھىش» نى تۈزەش خىزمىتىنىڭ نەتىجىلىرىنى ھەقىقىي مۇستەھكەملەش كېرەك.
بۇ چاغدا چەتئەلدە داۋاملىق خىزمەت قىلىش پۇرسىتىگە ئىگە بولغان گاۋ خۇيجۈن تاللاشقا دۇچ كەلدى، بۇ چاغدا ئۇنىڭ تېخىمۇ كۆپ ئويلىغىنى خاربىن سانائەت پەنلىرى داشۆسىنىڭ ئۆزىنى يېتىشتۈرۈشكە سىڭدۈرگەن ئەجرى بولدى.
پۇل-مۇئامىلە كىرزىسىگە قانداق تاقابىل تۇرۇش ھەمدە خەلقئارا تەشكىلاتلارنىڭ رولىنى قانداق جارى  قىلدۇرۇش-- كىشىلەر دىققەت قىلدىغان نۇقتا بولۇپ قالدى .
يان تېلېفۇندىكى كىچىككىنە پارتىيە قۇرۇلۇشى سۇپىسىدا « پارتىيە ئىشلىرى ، ھۆكۈمەت ئىشلىرى ، مۇلازىمەت » قاتارلىق كۆپ خىل ئىقتىدارلار توپلانغان بولۇپ ، پارتىيە تەشكىلاتى پائالىيىتىنىڭ شەكىلىنى بېيىتىپ ، ئاممىغا ئەڭ يېقىن ئارىلىقتا مۇلازىمەت قىلىپ ، كەڭ پارتىيە ئەزالىرى ، ئامما ياقتۇرىدىغان « ئىنقىلابىي روھ ئائىلىسى »گە ئايلاندى .
ئالاقە تورى ئارقىلىق دوختۇرلار بىلەن خەلقنىڭ ئالاقىسىنى ئورناتقاندا ، دوختۇرلار بىمارلارنىڭ ئەھۋالىنى ھەرۋاقىت ئىگىلەپ ، كېسەللىكلەرنىڭ ۋاقتىدا ئالدىنى ئېلىپ ، باشقۇرۇپ ، بىمارلارنى داۋالىيالايدۇ .
«13- بەش يىللىق» يىرىك پىلان مەزگىلىدە، ئاپتونوم رايونىمىزدىكى دۆلەت تۆمۈريولى قۇرۇلۇش تۈرلىرىگە سېلىنىدىغان مەبلەغنىڭ 48 مىليارد 500 مىليون يۈەن ئەتراپىدا بولىدىغانلىقى مۆلچەرلەندى.
قېرىلىشىش جەمئىيىتىنىڭ يېتىپ كېلىشىگە ئەگىشىپ، ماشىنا ئادەم ياپونىيەدىكى ياشانغانلارنىڭ ياخشى ياردەمچىسىگە ئايلاندى، شاڭخەي دۇنيا يەرمەنكىسىدە جامائەتچىلىككە كۆرسىتىلىدىغان  ماشىنا ئادەمنىڭ بەزىلىرى ئۆي ئىشلىرىنى قىلسا، بەزىلىرى ئاددى داۋالاش مۇلازىمىتى قىلالايدۇ، يەنە بەزى ماشىنا ئادەملەر ئىسكىرىپكا چېلىپ  ھارغىنلىقىڭىزنى چىقىرالايدۇ.
شۆھرەت زاكىر مۇنداق دېدى: پارتىيە 18- قۇرۇلتىيىدىن بۇيان، پارتىيە مەركىزىي كومىتېتى، گوۋۇيۈەن «ھوقۇقىنى چۈشۈرۈپ بىرىش، باشقۇرۇش، مۇلازىمەت قىلىش» ئىسلاھاتىنى چوڭقۇرلاشتۇرۇش توغرىسىدا بىر قاتار ئورۇنلاشتۇرمىلارنى ئېلىپ باردى، ئېنىق تەلەپلەرنى ئوتتۇرىغا قويدى.
دۆلەت ئىستاتىسىتكا ئىدارىسى بۈگۈن ئېلان قىلغان سانلىق مەلۇماتتا كۆرسىتىلىشچە ، 1-ئايدىن 4-ئايغىچە مەملىكەت بۇيىچە كۆلەملىك سانائەت كارخانىلىرى ياراتقان پايدا بىر ترىليۇن 610مىليارد 690مىليۇن يۈەنگە يېتىپ ، بۇلتۇرنىڭ ئوخشاش مەزگىلدىكىدىن ٪11.4ئاشقان ، ئېشىش سۈرئىتى ئالدىنقى ئۈچ ئايدىكىدىن ٪0.7تۆۋەنلىگەن .
ئەينى چاغدىكى نۇقتىلىق شەخس، 2007-يىلىدىكى ناخشىچىلارنى تاللاش مۇسابىقىسىدە 2-لىككە ئېرىشكەن رايدىئان ھازىر ئۆزىنىڭ تۇنجى پلاستىنكىسىنى چىقاردى.
نېپالدا 8.1 بال كۈچلۈك يەر تەۋرىگىنىگە 36 سائەت بولدى ، تۇيۇقسىز  يۈز بەرگەن  يەر تەۋرەشتە نېپالدا نۇرغۇن ئادەم قازا قىلىپ ، نۇرغۇن مال-مۈلۈك زىيانغا ئۇچرىدى ، بۈگۈن  چۈشتىن كېيىن سائەت بەشكىچە ، يەر تەۋرەشتە ئېلىمىزنىڭ شىزاڭ ئاپتونوم رايونىدىن 18 ئادەم قازا قىلىپ ، 200 نەچچە مىڭ ئادەم ئاپەتكە ئۇچرىدى .
خېنەن ئۆلكىسى شاڭشۈي ناھىيەسى دۆلەتنىڭ تۇتاش كەتكەن قېيىنچىلىقى ئېغىر رايونىدىكى نۇقتىلىق ناھىيە، شۇ جايدىكى ھۆكۈمەت يۇرتىدا قالغان ئاياللارنىڭ ئىشقا ئورۇنلىشىش جەھەتتىكى ئالاھىدىلىكىنى كۆزدە تۇتۇپ،«چىۋەر كېلىنچەك قۇرۇلۇشى »نى يولغا قويدى، پۈتۈن ناھىيەدىكى 200مىڭغا يېقىن يۇرتىدا قالغان ئايال ئۆيىنىڭ ئالدىلا پۇل تاپالايدىغان بولدى.
مۆلچەرلىنىشىچە ، مەزكۇر لىنىيە سېخىمىسىنى ئىجرا قىلىشقا  ئالدىمىزدىكى  6 ئايدا  489 مىليون دوللار ، تەخمىنەن 3 مىليارد يۈەن سەرپ قىلىنىدىكەن .
10-ئاينىڭ 17-كۈنى، جۇڭگونىڭ نامراتلارنى يۆلەش كۈنى بولۇپلا قالماي، ھەم دۇنيا نامراتلىقنى تۈگىتىش كۈنى .
بۇ قېتىمقى مەملىكەتلىك ئېكولوگىيەلىك موھت ئاسراش يىغىنىدىمۇ مۇنۇلار ئېنىق ئوتتۇرىغا قويۇلدى: ئېكولوگىيەلىك مەدەنىيەت سىستېمىسى ، ئېكولوگىيەلىك ئىقتىساد سىستېمىسى ، نىشان مەسئۇلىيەت سىستېمىسى ، ئېكولوگىيە مەدەنىيىلىكى تۈزۈمى سىستېمىسى ۋە ئېكولوگىيە بىخەتەرلىكى سىستېمىسىنى ئۆز ئىچىگە ئالغان ئېكولوگىيە مەدەنىيەت سىستىمىسى بەرپا قىلىنىدۇ .
ئۇلۇغ بوۋام پارتىيىگە مىننەتدارلىق بىلدۈرۈش ئۈچۈن بېيجىڭغا بارغان ، ھازىر مەن ۋە مومام ئىككىمىز پارتىيىگە مىننەتدارلىق بىلدۈرۈش ئۈچۈن باش شۇجى شى جىنپىڭغا خەت يازدۇق .
بۈگۈن ، بىزنىڭ ئورتاق ئىدىيە- سىياسىي ئاساسىمىز جۇڭگوچە سوتسىيالىزىم.
رەئىس شى جىنپىڭ بۇ قېتىم  ئەنگىلىيەدە زىيارەتتە بولغان مەزگىلدە، جۇڭگو بىلەن ئەنگىلىيە 21-ئەسىرگە يۈزلەنگەن يەرشارى ئوموميۈزلۈك ئىستىراتېگىيەلىك ھەمراھلىق مۇناسىۋىتىنى ئورتاق بەرپا قىلىش، ئۇزاققىچە داۋاملىشىدىغان، ئېچىۋېتىلگەن، تەڭ مەنپەئەتلىنىدىغان «ئالتۇن دەۋر»نى ئورتاق ئېچىش توغرىسىدا ئورتاق تونۇش ھاسىل قىلدى.
لېكىن ناھايىتى ئېنىقكى بۇ خراجەت يەتمەسلىكنى باھانە قىلىپ،  كۆرەلەيدىغان ئۈچ تەرەپنىڭ تېمىنى سىرلاپ ياخشى ھالەتنى شەكىللەندۈرۈشكە ئالدىرىغان،  خەلق ئويلىغاننى ئويلاپ ئۇلارغا بەخت  ئاتا قىلىشنى ئويلىشىپمۇ قويمىغان.
ۋۇشىڭ تەڭگىسى ھەم پۇلغا تەۋە ئەمەس ھەم  قىممىتىنىڭ ئېشىش  ئاساسى يوق، دۆلەت ھەم ھۆكۈمەت  ئېتىراپ قىلمىغان، پەقەت ئويۇندىكى مەۋھۇم بىر دۆۋە تەڭگە خالاس، قانچىلىك تارقاتقىسى كەلسە شۇنچىلىك تارقىتىدۇ،  پۈتۈنلەي شەخسنىڭ ئىختىيارلىقىدا بولىدۇ.
بۇلايېر ئىراق زۇڭلىسى مالىكى بىلەن سۆھبەتلەشكەندىن كېيىن ،مالىكىنى پۈتۈن كۈچى بىلەن قوللايدىغانلىقىنى، ئىراقتىكى ئېغىر مەزھەپلەر توقۇنىشىنى توسۇيدىغانلىقىنى بىلدۈردى.
بىز يەنە لىنىيە مەھسۇلاتلىرىنى پىلانلاش، ئۆي ئاپتوموبىلى لاگىرى قۇرۇلۇشى، بىرلىشىپ تەشۋىق قىلىش ۋە كېڭەيتىش، يولۇچىلار مەنبەسىنى ئۆزئارا يەتكۈزۈش قاتارلىق جەھەتلەردە ھەمتۈرتكە بولۇپ ۋە ئۇدۇللاشتۇرۇپ، ساياھەت تەرەققىياتىنىڭ يېڭى سەھىپىسىنى ئاچىمىز.
2017-يىلىنىڭ ئاخىرىغىچە مەملىكەت بويىچە تۆمۈر يولنىڭ تىجارەتلىك مۇساپىسى 127مىڭ كىلومېتىرغا يەتتى، بۇنىڭ ئىچىدە يۇقىرى سۈرئەتلىك تۆمۈر يول25مىڭ كىلومېتىر بولۇپ، دۇنيا يۇقىرى سۈرئەتلىك تۆمۈر يول ئومومىي مۇساپىسىنىڭ ئۈچتىن ئىككى قىسمىنى ئىگىلىدى.
مونترېئالدىكى جۇڭگۇلۇقلار، خۇاچياۋلار بىرلىشىپ چاغاننى كۈتۈۋىلىش پائالىيەتلىرىنى تەشكىللىدى، ۋەتەندىن كەلگەن سەنئەت ئۆمەكلىرى ئويۇن قويدى، تۇنجى نۆۋەتلىك جۇڭگۇلۇقلار، خۇاچياۋلارنىڭ چاغانلىق بۇتخانا سەيلىسى ۋە جۇڭگۇلۇقلار، خۇاچياۋلارنىڭ بىرلەشمە چاغانلىق سەنئەت كېچىلىكى ئۆتكۈزۈلدى.
نەنجىڭ شەھرىنىڭ بەلگىلىمىسىگە ئاساسەن،ۋاكالىتەن باشقۇرۇش يولغا قۇيۇلغاندىن كىيىن دوختۇرخانىنىڭ دورا باھاسى ٪5 دىن ٪10 كىچە چۈشۈشى كىرەك.